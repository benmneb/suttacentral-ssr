{
  "name": "suttacentral-ssr",
  "description": "A fast and minimal alternative frontend for SuttaCentral.net",
  "version": "0.0.1",
  "author": "benmneb",
  "license": "CC0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "node scripts/shard-dictionaries.ts && astro dev",
    "build": "node scripts/shard-dictionaries.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "fetch-dicts": "node scripts/fetch-dictionaries.ts",
    "build-hans": "node scripts/build-hans.ts",
    "build-map": "node scripts/build-map.ts",
    "build-sitemap": "node scripts/build-sitemap.ts",
    "shard-dicts": "node scripts/shard-dictionaries.ts",
    "sync-i18n": "node scripts/sync-i18n.ts",
    "sync-api-constants": "node scripts/sync-api-constants.ts",
    "test": "node --test --test-isolation=none --test-global-setup=tests/lib/setup.ts 'tests/*.test.ts'"
  },
  "engines": {
    "node": ">=23.6"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@puppeteer/browsers": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "axe-core": "^4.14.0",
    "daisyui": "^5.5.11",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "unstorage": "^1.17.4",
    "vnu-jar": "^26.10.12",
    "wrangler": "^4.151.1"
  }
}
