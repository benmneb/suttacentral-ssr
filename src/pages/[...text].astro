---
import '~/assets/text.css'
import '~/assets/text-icons.css'
import ParallelList from '~/components/parallel-list.astro'
import PublicationInfo from '~/components/publication-info.astro'
import TextMetaContent from '~/components/text-meta-content.astro'
import Icon from '~/components/icon.astro'
import { icon } from '~/constants/heroicons'
import { AVAILABLE_LOOKUPS } from '~/constants/lookup'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import { getViewPrefs } from '~/utils/cookies'
import { langTag, langTagsIn } from '~/utils/language'
import { textMetadata } from '~/utils/json-ld'
import {
  referenceEditionName,
  referenceEditions,
} from '~/constants/reference-editions'
import {
  acronymOf,
  PARALLEL_TYPES,
  parallelType,
  parallelTypeTitle,
  parseParallelKey,
} from '~/utils/parallels'
import {
  authorName,
  bilaraMarkup,
  closeHeadingGaps,
  dropEmptyHeadings,
  headingRenumberer,
  parseUidNumbers,
  rangeUidToAcronym,
  softHyphenateTitle,
  toSentenceCase,
  uidIsInRange,
} from '~/utils/strings'
import { getUrlViewPrefs } from '~/utils/url-prefs'

const { text } = Astro.params
// A .net link's settings win over the reader's for this page only
const { prefs: urlPrefs, sources: urlSources } = getUrlViewPrefs(
  Astro.url.searchParams
)
const viewPrefs = { ...getViewPrefs(Astro.cookies), ...urlPrefs }
// So the prefs script leaves a setting the link chose out of the cookie
const fromUrl = (id: string) =>
  id in urlSources ? { 'data-from-url': urlSources[id] } : {}
const userLanguage = Astro.locals.userLanguage

const parts = text!.split('/') // will be a string like "dn1/en/sujato"
if (parts.length !== 3) {
  Astro.response.status = 404
  Astro.response.statusText = 'Invalid text path format'
  return Astro.rewrite('/404')
}
const [acronym, language, authorUid] = parts
const lowerAcronym = acronym.toLowerCase()

const suttasResponse = await fetch(
  `https://suttacentral.net/api/suttas/${lowerAcronym}/${authorUid}?lang=${language}&siteLanguage=${userLanguage}`
)
const suttasData = await suttasResponse.json()

const isRangeSutta = !!suttasData.range_uid

if (!suttasData.root_text && !suttasData.translation) {
  for (const author of suttasData.candidate_authors ?? []) {
    const response = await fetch(
      `https://suttacentral.net/api/suttas/${lowerAcronym}/${author}?lang=${language}&siteLanguage=${userLanguage}`
    )
    const data = await response.json()
    if (data.root_text || data.translation) {
      return Astro.redirect(
        `/${lowerAcronym}/${language}/${author}${Astro.url.search}`
      )
    }
  }

  // No text and no author left to try means either the uid is a fallen leaf -
  // parallels but no text of its own, eg pli-tv-bi-vb-pj1 - or it isn't a real
  // uid. The api still returns a suttaplex for the first and none for the
  // second, which is what tells them apart. A fallen leaf has nothing but its
  // suttaplex page, where .net sends these too; the rest take the 404 below
  if (suttasData.suttaplex?.uid) {
    return Astro.redirect(
      `/${suttasData.suttaplex.uid}${Astro.url.search}`,
      301
    )
  }

  Astro.response.status = 404
  Astro.response.statusText = 'Text not found'
  return Astro.rewrite('/404')
}

const suttaplexResponse = await fetch(
  `https://suttacentral.net/api/suttaplex/${suttasData.range_uid ?? lowerAcronym}?language=${userLanguage}`
)
const suttaplexData = await suttaplexResponse.json()

if (!suttaplexData?.[0]?.uid) {
  Astro.response.status = 404
  Astro.response.statusText = 'Suttaplex UID not found'
  return Astro.rewrite('/404')
}

for (const text of [
  suttasData.root_text,
  suttasData.translation,
  ...(suttaplexData[0].translations ?? []),
]) {
  if (text?.author_uid === 'sct') text.author = authorName(text)
}

let bilaraData: any = {}
let displayedUid: string | null = null // which bilara document gets rendered
let keyPrefixes: string[] = [] // all of them in the response, in order
if (suttasData.segmented) {
  const bilaraResponse = await fetch(
    `https://suttacentral.net/api/bilarasuttas/${suttasData.range_uid ?? lowerAcronym}/${authorUid}?lang=${language}`
  )
  bilaraData = await bilaraResponse.json()

  if (bilaraData.msg === 'Not Found') {
    Astro.response.status = 404
    Astro.response.statusText = 'Bilara data not found'
    return Astro.rewrite('/404')
  }

  for (const texts of [bilaraData.root_text, bilaraData.translation_text]) {
    for (const key in texts) texts[key] = bilaraMarkup(texts[key])
  }
  // A space left a link dead, as DN 16's "/sn47.14 /en/sujato" once was
  for (const key in bilaraData.comment_text) {
    bilaraData.comment_text[key] = bilaraData.comment_text[key].replace(
      /href=(['"])([^'"]*\s[^'"]*)\1/g,
      (_: string, quote: string, url: string) =>
        `href=${quote}${url.replace(/\s+/g, '')}${quote}`
    )
  }

  // As .net has them: no whitespace (dn33:1.11.85), no id the text has (pdhp2)
  if (bilaraData.reference_text) {
    const ids = new Set<string>()
    for (const html of Object.values<string>(bilaraData.html_text ?? {})) {
      for (const [, id] of html.matchAll(/\bid=['"]([^'"]+)/g)) ids.add(id)
    }
    for (const key in bilaraData.reference_text) {
      bilaraData.reference_text[key] = bilaraData.reference_text[key]
        .replace(/\s+/g, '')
        .split(',')
        .filter((ref: string) => ref && !ids.has(ref))
        .join(',')
    }
  }

  // The bilara keys are what can actually be isolated. Usually that's one
  // prefix per sutta (an1.1:…, an1.2:…), but some ranges are a single document
  // keyed by the range itself (sn45.50-54:…) and some nest a sub-range inside a
  // wider one (an1.175-186:… inside range_uid an1.170-187). Either way the
  // containing document is the smallest thing there is to show - as on .net
  keyPrefixes = [
    ...new Set<string>(
      bilaraData.keys_order.map((key: string) =>
        key.split(':')[0].toLowerCase()
      )
    ),
  ]
  displayedUid =
    keyPrefixes.find(prefix => prefix === lowerAcronym) ??
    keyPrefixes.find(prefix => uidIsInRange(lowerAcronym, prefix)) ??
    null

  if (isRangeSutta && displayedUid) {
    const matchKey = (key: string) =>
      key.split(':')[0].toLowerCase() === displayedUid ||
      bilaraData.html_text[key]?.includes("class='range'") ||
      bilaraData.html_text[key]?.includes("class='range-title'") ||
      bilaraData.html_text[key]?.includes("class='subdivision'")
    bilaraData.keys_order = bilaraData.keys_order.filter(matchKey)
    for (const prop of [
      'html_text',
      'root_text',
      'translation_text',
      'comment_text',
      'variant_text',
      'reference_text',
    ]) {
      if (!bilaraData[prop]) continue
      bilaraData[prop] = Object.fromEntries(
        Object.entries(bilaraData[prop]).filter(([key]) => matchKey(key))
      )
    }
  }
}

const [publicationData, crumbsData, parallelsData] = await Promise.all([
  fetch(
    `https://suttacentral.net/api/publication_info/${suttasData.range_uid ?? lowerAcronym}/${language}/${authorUid}`
  ).then(r => r.json()),
  fetch(
    `https://suttacentral.net/api/navigation_data/${suttasData.range_uid ?? lowerAcronym}?language=${userLanguage}`
  ).then(r => r.json()),
  fetch(`https://suttacentral.net/api/parallels/${suttaplexData[0].uid}`).then(
    r => r.json()
  ),
])
// When true the page shows a whole range document, not one sutta of it, so it
// should name the range rather than the uid that was asked for
const isWholeRange = !!displayedUid && displayedUid !== lowerAcronym
const displayedAcronym = isWholeRange
  ? displayedUid === suttaplexData[0].uid
    ? suttaplexData[0].acronym // eg "SN 45.50–54", straight from the API
    : rangeUidToAcronym(displayedUid!) // nested, eg "AN 1.175–186"
  : rangeUidToAcronym(lowerAcronym)

// A nested range reached by its own uid, eg /an1.175-186, is a bilara document
// id and nothing else - no suttaplex answers to it, so it has no chapter page
const shownUidNumbers = isRangeSutta ? parseUidNumbers(lowerAcronym) : null
const hasChapterPage =
  !shownUidNumbers || shownUidNumbers.start === shownUidNumbers.end

const modifiedCrumbsData = [
  ...crumbsData,
  {
    uid: lowerAcronym,
    // Names what it links to - the uid asked for, not what's on screen
    title: isRangeSutta
      ? rangeUidToAcronym(lowerAcronym)
      : suttaplexData[0].acronym,
    url: hasChapterPage ? `/${lowerAcronym}` : undefined,
  },
  { uid: authorUid, title: suttasData.translation.author },
]

let rangePrev: string | null = null
let rangeNext: string | null = null
if (isRangeSutta) {
  // Inside the document the neighbours are known exactly, its key prefixes being
  // the siblings in order - so a nested range gets linked as the one page it is,
  // and not as whichever of its numbers happens to come next
  const shownIndex = displayedUid ? keyPrefixes.indexOf(displayedUid) : -1
  if (shownIndex > 0) rangePrev = keyPrefixes[shownIndex - 1]
  if (shownIndex > -1 && shownIndex < keyPrefixes.length - 1)
    rangeNext = keyPrefixes[shownIndex + 1]

  // That leaves the ends of the response, where the next text along is a fetch
  // of its own, and legacy ranges, which have no keys at all. Both fall back to
  // counting by number within the vagga - from the ends of what's on screen,
  // not from the uid asked for, or "next" from sn45.50 is sn45.51, the same
  // page again
  const begin = parseUidNumbers(suttasData.vaggaBegin)
  const end = parseUidNumbers(suttasData.vaggaEnd)
  const shown = parseUidNumbers(displayedUid ?? lowerAcronym)
  if (begin && end && shown) {
    if (!rangePrev && shown.start - 1 >= begin.start)
      rangePrev = `${begin.prefix}${shown.start - 1}`
    if (!rangeNext && shown.end + 1 <= end.end)
      rangeNext = `${begin.prefix}${shown.end + 1}`
  }
}

const isSegmented = !!suttasData.segmented
const isRootText = language === suttaplexData[0].root_lang

// A legacy text's publication info is its own last <footer>
const hasLegacyInfo =
  !isSegmented && suttasData.translation.text.includes('<footer')
const hasPublicationInfo = !hasLegacyInfo && !!publicationData?.[0]
const hasInfo = hasLegacyInfo || hasPublicationInfo

const rootLang = suttasData.suttaplex?.root_lang
const availableLangs = rootLang ? AVAILABLE_LOOKUPS[rootLang] : null
const lookupTargetLang = availableLangs?.includes(userLanguage)
  ? userLanguage
  : 'en'
// Not for the other languages, whose dictionaries come from elsewhere
const lookupSource =
  rootLang === 'lzh'
    ? '<a href="http://www.buddhism-dict.net/ddb/">Digital Dictionary of Buddhism</a>'
    : lookupTargetLang === 'en'
      ? '<a href="https://digitalpalidictionary.github.io/">Digital Pāḷi Dictionary</a>'
      : null

function isHeadingHTML(html: string): boolean {
  return /<h[1-6][^>]*>\{\}/.test(html)
}

let commentsHtml = ''
// Not by the key, which has characters an anchor name can't
let noteCount = 0

type Illustration = {
  segment: string
  filename: string
  creator?: string
  creation_date?: string
  alt?: string
}

const illustrationsBySegment = new Map<string, Illustration[]>()
for (const illustration of (bilaraData.illustrations ?? []) as Illustration[]) {
  const { segment } = illustration
  illustrationsBySegment.set(segment, [
    ...(illustrationsBySegment.get(segment) ?? []),
    illustration,
  ])
}
const hasIllustrations =
  isSegmented &&
  bilaraData.keys_order.some((key: string) => illustrationsBySegment.has(key))

/** Markup the "Highlight text-critical details" setting styles, in text.css */
const HIGHLIGHT_MARKUP = new RegExp(
  `class=['"](?:[^'"]*\\s)?(?:${[
    'kamma',
    'patimokkha',
    'suttanta',
    'jataka',
    'nidana',
    'padabhajaniya',
    'cakka',
    'anapatti',
    'vinaya-vinita',
    'term',
    'gloss',
    'supplied2?',
    'surplus',
    'var',
    'corr(?:ected)?',
    'unclear',
    'expanded',
    'metre',
    ...(isSegmented ? ['rule'] : []),
  ].join('|')})['"\\s]|data-(?:counter|doxy|direction)=`
)
const hasHighlights = isSegmented
  ? [
      bilaraData.html_text,
      bilaraData.root_text,
      bilaraData.translation_text,
    ].some(texts =>
      Object.values((texts ?? {}) as Record<string, string>).some(html =>
        HIGHLIGHT_MARKUP.test(html)
      )
    )
  : HIGHLIGHT_MARKUP.test(suttasData.translation?.text ?? '')

// Here, not in text.css, as the marks are named in the reader's language
const markLabels = `:root { ${Object.entries({
  nidana: 'viewoption:markNidana',
  padabhajaniya: 'viewoption:markPadabhajaniya',
  cakka: 'viewoption:markCakka',
  anapatti: 'viewoption:markAnapatti',
  'vinaya-vinita': 'viewoption:markVinayaVinita',
  kamma: 'viewoption:markKamma',
  patimokkha: 'viewoption:markPatimokkha',
  rule: 'viewoption:markRule',
  suttanta: 'viewoption:markSuttanta',
  jataka: 'viewoption:markJataka',
  orthodox: 'viewoption:markOrthodox',
  heterodox: 'viewoption:markHeterodox',
  forward: 'viewoption:markForward',
  reverse: 'viewoption:markReverse',
  supplied: 'viewoption:markSupplied',
  surplus: 'viewoption:markSurplus',
  variant: 'viewoption:variant',
  corrected: 'viewoption:markCorrected',
  unclear: 'viewoption:markUnclear',
})
  .map(
    ([name, key]) => `--${name}-label: ${JSON.stringify(t(userLanguage, key))};`
  )
  .join(' ')} }`

/**
 * A passage the "Show parallels" setting brackets in the margin. The api keys
 * a parallel to where it starts, so it runs to the end of that section
 */
type ParallelRun = {
  start: number // indexes into shownKeys
  end: number
  type: string // the strongest of them, which the bracket is drawn as
  label: string
  groups: [string, any[]][] // type, parallels
  lane: number // 0 is closest to the text
}

// The keys that get rendered, so the ones a bracket can be anchored to
const shownKeys: string[] = isSegmented
  ? bilaraData.keys_order.filter(
      (key: string) =>
        bilaraData.html_text[key] &&
        (!isRangeSutta ||
          !displayedUid ||
          key.split(':')[0].toLowerCase() === displayedUid)
    )
  : []
const shownIndex = new Map(shownKeys.map((key, i) => [key, i]))
const referenceIndex = new Map<string, number>()
shownKeys.forEach((key, i) => {
  const uid = key.split(':')[0]
  for (const id of (bilaraData.reference_text?.[key] ?? '').split(',')) {
    if (id.trim()) referenceIndex.set(`${uid}:${id.trim()}`, i)
  }
})

function findShown(uid: string, ref: string) {
  return shownIndex.get(`${uid}:${ref}`) ?? referenceIndex.get(`${uid}:${ref}`)
}

// The keys sharing all but its last number
function sectionOf(key: string) {
  const [uid, ref] = key.split(':')
  return ref.includes('.') ? `${uid}:${ref.replace(/\.[^.]+$/, '')}` : key
}

const BLOCK_END = /\{\}.*<\/(?:p|blockquote|li|h\d|header|section|article)>/

// The end of the section `i` starts, or of the paragraph or verse it's in
function passageEnd(i: number) {
  const section = sectionOf(shownKeys[i])
  const inSection = (j: number) =>
    !!shownKeys[j] && sectionOf(shownKeys[j]) === section
  let end = i
  while (inSection(end + 1)) end++
  // Sections can open with a heading at .0, so .1 starts one too
  if (!inSection(i - 1) || /\.[01]$/.test(shownKeys[i])) return end
  while (i < end && !BLOCK_END.test(bilaraData.html_text[shownKeys[i]])) i++
  return i
}

// Every key of it on screen, or of the suttas a range key like sn12.1-2 covers
function wholeTextSpan(base: string) {
  const covered = shownKeys
    .map((key, i) => [key.split(':')[0], i] as const)
    .filter(([uid]) => uid === base || uidIsInRange(uid, base))
    .map(([, i]) => i)
  return covered.length ? [covered[0], covered.at(-1)!] : null
}

function parallelSpan(key: string) {
  const { base, start, end } = parseParallelKey(key)
  if (!start) return wholeTextSpan(base)
  const first = findShown(base, start)
  const last = findShown(base, end!)
  if (first === undefined || last === undefined || last < first) return null
  return [first, passageEnd(last)]
}

function spanLabel(key: string, start: number, end: number) {
  const { base, start: from } = parseParallelKey(key)
  const acronym = acronymOf(base, suttaplexData[0])
  if (!from) return acronym
  const ref = (i: number) => shownKeys[i].split(':')[1]
  const refs = start === end ? ref(start) : `${ref(start)}–${ref(end)}`
  return `${acronym}:${refs}`
}

const runsBySpan = new Map<string, ParallelRun>()
for (const [key, parallels] of Object.entries(parallelsData ?? {})) {
  if (key.startsWith('_scx_') || !Array.isArray(parallels)) continue
  const span = parallelSpan(key)
  if (!span) continue
  const [start, end] = span
  const id = `${start}-${end}`
  const run: ParallelRun = runsBySpan.get(id) ?? {
    start,
    end,
    type: '',
    label: spanLabel(key, start, end),
    groups: [],
    lane: 0,
  }
  for (const parallel of parallels) {
    const type = parallelType(parallel)
    const group = run.groups.find(([t]) => t === type)
    if (group) group[1].push(parallel)
    else run.groups.push([type, [parallel]])
  }
  runsBySpan.set(id, run)
}

const rank = (type: string) =>
  (PARALLEL_TYPES as readonly string[]).indexOf(type) >>> 0 // unknown last
const parallelRuns = [...runsBySpan.values()].sort(
  (a, b) => a.start - b.start || b.end - a.end
)
for (const run of parallelRuns) {
  run.groups.sort(([a], [b]) => rank(a) - rank(b))
  run.type = PARALLEL_TYPES.find(type => type === run.groups[0][0]) ?? 'mention'
}

// Overlapping, or one ending on the line the next starts on
function clash(a: ParallelRun, b: ParallelRun) {
  const meets = (x: ParallelRun, y: ParallelRun) =>
    x.end + 1 === y.start &&
    !BLOCK_END.test(bilaraData.html_text[shownKeys[x.end]])
  return (a.start <= b.end && b.start <= a.end) || meets(a, b) || meets(b, a)
}

// Like a git graph: shortest first, each in the nearest lane without a clash
const lanes: ParallelRun[][] = []
for (const run of parallelRuns.toSorted(
  (a, b) => a.end - a.start - (b.end - b.start) || a.start - b.start
)) {
  let lane = lanes.findIndex(others => !others.some(o => clash(o, run)))
  if (lane === -1) lane = lanes.push([]) - 1
  lanes[lane].push(run)
  run.lane = lane
}

const hasParallels = parallelRuns.length > 0

const hasReferences =
  isSegmented || suttasData.translation.text.includes("class='ref")

/** A reference's group in the menu, as .net's M and T keys have them */
function referenceGroup(id: string) {
  if (/^(sc|vns)/.test(id)) return 'main'
  if (/^(pts|vnp)/.test(id)) return 'pts'
  return 'others'
}

// Every reference this text has: ids in a segmented one, classes in a legacy
const referenceIds: string[] = isSegmented
  ? Object.values(bilaraData.reference_text ?? {}).flatMap(v =>
      String(v)
        .split(',')
        .map(id => id.trim())
        .filter(Boolean)
    )
  : [...suttasData.translation.text.matchAll(/class='ref ([^' ]+)/g)].map(
      m => m[1]
    )
const referenceGroups = new Set<string>(referenceIds.map(referenceGroup))
// Segmented texts always have their own number
if (isSegmented) referenceGroups.add('main')
// With only one group the References checkbox says it all
const hasReferenceGroups = referenceGroups.size > 1

// A line each, as the names have commas of their own
const otherEditions = [
  ...new Set(
    referenceIds
      .filter(id => referenceGroup(id) === 'others')
      .map(id => referenceEditionName(id) ?? id.replace(/\d.*$/, ''))
  ),
].join('\n')

// The segments a bracket starts or ends on, so it can be anchored to them
const parallelAnchors = new Set(parallelRuns.flatMap(r => [r.start, r.end]))
function anchorStyle(key: string) {
  const i = shownIndex.get(key)
  return i !== undefined && parallelAnchors.has(i)
    ? ` style="--anchor: --ps${i}"`
    : ''
}

/** Spans, as a <figure> can't go inside the <p> they usually end */
function renderIllustrations(key: string) {
  return (illustrationsBySegment.get(key) ?? [])
    .map(({ filename, alt = '', creator, creation_date }) => {
      const credit = [creator, creation_date].filter(Boolean).join(', ')
      return `
      <span class="illustration" role="figure">
        <img src="https://suttacentral.net/img/optimized-illustrations/${filename}.avif" alt="${alt.replace(/"/g, '&quot;')}" loading="lazy" decoding="async">
        ${credit ? `<span class="caption">${credit}</span>` : ''}
      </span>`
    })
    .join('')
}

type TocEntry = { level: number; href: string; html: string; isTitle?: boolean }
const toc: TocEntry[] = []

function tocLabel(text: string): string {
  const stripped = text.trim().replace(/^\d+(?:\.\d+)*\.\s*/, '')
  // A heading that is only a number would leave a link with no name
  return stripped || text.trim()
}

// A page of several texts repeats a number like 1.1, so it takes .net's whole
// key on a range like an1.1-10 (an1.2_1.1), and elsewhere (dhp1-20) keeps the
// short one where first used, where a .net link lands
const isMultiTextRange =
  new Set(shownKeys.map(key => key.split(':')[0])).size > 1 &&
  /^\d+-\d+$/.test(lowerAcronym.split('.')[1] ?? '')
const segmentIds = new Map<string, string>()
const seenRefs = new Set<string>()
for (const key of shownKeys) {
  const ref = key.split(':').pop()!
  if (isMultiTextRange || seenRefs.has(ref))
    segmentIds.set(key, key.replace(':', '_'))
  seenRefs.add(ref)
}

/**
 * The reference span for a segment: the SuttaCentral number, then an anchor per
 * id in `reference_text` - "bj10.20, cck12.12, ms9M_53" and so on.
 * All of them, as a fragment never reaches the server
 */
function renderReferences(key: string, ref: string) {
  const ids = (bilaraData.reference_text?.[key] ?? '')
    .split(',')
    .map((id: string) => id.trim())
    .filter(Boolean)
  const id = segmentIds.get(key) ?? ref

  return `
      <span class="reference" id="${id}" hidden>
        <a href="#${id}" title="${t(userLanguage, 'text:segmentNumber')}">${isMultiTextRange ? key : ref}</a>
        ${ids
          .map(
            (id: string) =>
              `<a class="ref ${referenceGroup(id)}" id="${id}" href="#${id}" title="${referenceEditionName(id) ?? id}">${id}</a>`
          )
          .join('')}
      </span>`
}

const renumberHeading = headingRenumberer()

/**
 * Record a segmented heading for the table of contents, at the level
 * `closeHeadingGaps` gives it on the page
 */
function collectHeading(html: string, key: string, text?: string) {
  const heading = html.match(/<h([2-4])([^>]*)>(?=\{\})/)
  // As `dropEmptyHeadings` takes it off the page
  const isDropped =
    !bilaraData.root_text?.[key]?.trim() &&
    (isRootText || !bilaraData.translation_text?.[key]?.trim())
  let level = 0
  for (const match of html.matchAll(/<h([1-6])(?=[\s>])[^>]*>(\{\})?/g)) {
    if (match[2] && isDropped) continue
    const to = renumberHeading(Number(match[1]))
    if (match.index === heading?.index) level = to
  }
  if (!heading || !text?.trim()) return
  toc.push({
    level,
    href: `#${key}`,
    html: tocLabel(text),
    // On a range page (eg an1.1-10) each sutta's own title is the only
    // structure there is, so these stay - but on a single sutta of that range
    // the one title is just the page title, and gets dropped below
    isTitle: heading[2].includes('sutta-title'),
  })
}

function getRootLangHTML() {
  if (!isSegmented || !isRootText) return null

  return bilaraData.keys_order
    .map(key => {
      const html = bilaraData.html_text[key]
      const text = bilaraData.root_text[key]
      const comment = bilaraData.variant_text?.[key]
      const ref = key.split(':').pop()
      const commentNote = comment ? noteCount++ : 0

      if (!html) return ''

      collectHeading(html, key, text)
      const isHeading = isHeadingHTML(html)

      const segment = `
    <span id="${key}" class="segment"${anchorStyle(key)}>
${renderReferences(key, ref)}
      ${
        text
          ? `
      <!-- This is not a translation, its the root text, the class is so it's not \`display: none\` by default. -->
      <span class="translation" lang="${langTag(suttasData.root_text.lang)}" translate="no">
        <span class="text">${isHeading ? softHyphenateTitle(text) : text}</span>
        ${
          comment
            ? `
        <button class="variant-btn" popovertarget="comment-${key}" style="--anchor: --note${commentNote}" aria-label="${t(userLanguage, 'viewoption:showVariantReading', { ref })}">*</button>
        <span class="inline-comment" hidden>
          ${t(userLanguage, 'viewoption:variant')} ${comment.replace(/https:\/\/suttacentral\.net/g, '')}
        </span>
        `
            : ''
        }
      </span>
      `
          : ''
      }
${renderIllustrations(key)}
    </span>
  `

      if (comment) {
        commentsHtml += `
      <article id="comment-${key}" popover style="--anchored-to: --note${commentNote}">
        ${t(userLanguage, 'viewoption:variant')} ${comment.replace(/https:\/\/suttacentral\.net/g, '')}
      </article>
    `
      }

      return html.replace('{}', segment)
    })
    .join('')
}

function getSegmentedHTML() {
  if (!isSegmented || isRootText) return null

  return bilaraData.keys_order
    .map(key => {
      const html = bilaraData.html_text[key]
      const text = bilaraData.translation_text[key]
      const rootText = bilaraData.root_text[key]
      const comment = bilaraData.comment_text?.[key]
      const variant = bilaraData.variant_text?.[key]
      const ref = key.split(':').pop()
      const commentNote = comment ? noteCount++ : 0
      const variantNote = variant ? noteCount++ : 0

      if (!html) return ''

      collectHeading(html, key, text)
      const isHeading = isHeadingHTML(html)

      const segment = `
    <span id="${key}" class="segment"${anchorStyle(key)}>
${renderReferences(key, ref)}
      ${
        text
          ? `
      <span class="translation" lang="${langTag(suttasData.translation.lang)}">
        <span class="text">${text}</span>
        ${
          comment
            ? `
        <button popovertarget="comment-${key}" style="--anchor: --note${commentNote}" aria-label="${t(userLanguage, 'viewoption:showFootnote', { author: suttasData.translation.author, ref: key })}">*</button>
        <span class="inline-comment" hidden>
          <span class="sr-only">${t(userLanguage, 'viewoption:noteLabel')}</span> ${comment.replace(/https:\/\/suttacentral\.net/g, '')}
        </span>
        `
            : ''
        }
      </span>
      `
          : ''
      }
      ${
        rootText
          ? `
      <span class="root" lang="${langTag(suttasData.suttaplex.root_lang)}" translate="no" hidden>
        <span class="text">${isHeading ? softHyphenateTitle(rootText) : rootText}</span>
        ${
          variant
            ? `
      <button class="variant-btn" popovertarget="variant-${key}" style="--anchor: --note${variantNote}" aria-label="${t(userLanguage, 'viewoption:showVariantReading', { ref })}">*</button>
      <span class="inline-comment" hidden>
        ${t(userLanguage, 'viewoption:variant')} ${variant.replace(/https:\/\/suttacentral\.net/g, '')}
      </span>
      `
            : ''
        }
      </span>
      `
          : ''
      }
${renderIllustrations(key)}
    </span>
  `

      if (comment) {
        commentsHtml += `
      <article id="comment-${key}" popover style="--anchored-to: --note${commentNote}">
        ${comment.replace(/https:\/\/suttacentral\.net/g, '')}
      </article>
    `
      }
      if (variant) {
        commentsHtml += `
      <article id="variant-${key}" popover style="--anchored-to: --note${variantNote}">
        ${t(userLanguage, 'viewoption:variant')} ${variant.replace(/https:\/\/suttacentral\.net/g, '')}
      </article>
    `
      }

      return html.replace('{}', segment)
    })
    .join('')
}

function getLegacyHTML() {
  if (isSegmented) return null

  let text: string = suttasData?.translation.text
  // Some come as a whole document (mn10/horner), which can't go in <main>
  const bodyStart = text.indexOf('<body')
  if (bodyStart !== -1) {
    const bodyEnd = text.lastIndexOf('</body>')
    text = text.slice(
      text.indexOf('>', bodyStart) + 1,
      bodyEnd === -1 ? undefined : bodyEnd
    )
  }

  const htmlContent = text
    .replace(/\n/g, '')
    .replace(
      /class='ref ([^' ]+)/g,
      (match: string, id: string) => `${match} ${referenceGroup(id)}`
    )
  // Extract the last <footer>...</footer> (its the publication info)
  const footerParts = htmlContent.split('<footer')
  const lastFooterPart = footerParts[footerParts.length - 1]
  const footerContent = lastFooterPart.split('</footer>')[0]
  const originalFooter = hasLegacyInfo
    ? '<footer' + footerContent + '</footer>'
    : ''
  const htmlWithoutFooter = htmlContent.replace(originalFooter, '')
  const modifiedFooter = originalFooter
    .replace('<footer', '<article id="info" popover')
    .replace('</footer>', '</article>')

  // Collect headings for the table of contents, giving them an id to anchor to
  // - legacy texts don't have any (eg pli-tv-kd1/horner has 67 bare headings)
  const renumber = headingRenumberer()
  const levels = new Map<number, number>()
  for (const match of htmlWithoutFooter.matchAll(/<h([1-6])(?=[\s>])/g)) {
    levels.set(match.index, renumber(Number(match[1])))
  }
  let n = 0
  const htmlWithHeadingIds = htmlWithoutFooter.replace(
    /<h([2-4])([^>]*)>([\s\S]*?)<\/h\1>/g,
    (
      match: string,
      level: string,
      attrs: string,
      inner: string,
      offset: number
    ) => {
      const existingId = attrs.match(/\bid=["']([^"']+)["']/)
      const id = existingId?.[1] ?? `toc-${++n}`
      if (inner.trim()) {
        toc.push({
          level: levels.get(offset)!,
          href: `#${id}`,
          html: tocLabel(inner),
        })
      }
      return existingId
        ? match
        : `<h${level}${attrs} id="${id}">${inner}</h${level}>`
    }
  )

  return htmlWithHeadingIds + modifiedFooter
}

const rootLangHTML = getRootLangHTML()
const segmentedHTML = getSegmentedHTML()
const legacyHTML = getLegacyHTML()

const articleHTML = closeHeadingGaps(
  dropEmptyHeadings(langTagsIn(rootLangHTML || segmentedHTML || legacyHTML))
)

// A lone sutta title is the page title, not a table of contents
if (toc.length === 1 && toc[0].isTitle) toc.length = 0

// The widest contents number's width: a digit is 1ch, a dot a little over half
const tocCounts = [0, 0, 0]
let tocNumberWidth = 0
for (const { level, isTitle } of toc) {
  const i = level - 2
  if (!isTitle) tocCounts[i]++
  tocCounts.fill(0, i + 1)
  if (isTitle) continue
  const digits = tocCounts.slice(0, i + 1).join('').length
  tocNumberWidth = Math.max(tocNumberWidth, digits + (i + 1) * 0.6)
}
const tocStyle = tocNumberWidth
  ? `--toc-number-width: ${tocNumberWidth.toFixed(1)}ch`
  : undefined

const metadata = textMetadata(userLanguage, {
  suttasData,
  suttaplexEntry: suttaplexData[0],
  publication: publicationData?.[0],
  crumbs: modifiedCrumbsData,
  lang: language,
  authorUid,
  uid: lowerAcronym,
  workUid: hasChapterPage ? lowerAcronym : suttaplexData[0].uid,
  acronym: isRangeSutta ? displayedAcronym : suttaplexData[0].acronym,
  isIndividualRangeSutta: isRangeSutta && lowerAcronym !== suttaplexData[0].uid,
})
