---
import RootTitle from '~/components/root-title.astro'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import { generateIndexJsonLd } from '~/utils/json-ld'

const userLanguage = Astro.locals.userLanguage

const tipitakaResponse = await fetch(
  `https://suttacentral.net/api/tipitaka_menu?language=${userLanguage}`
)
const tipitakaData = await tipitakaResponse.json()

const origin = Astro.site?.origin ?? ''
const jsonLd = generateIndexJsonLd(tipitakaData, origin)

// eg "Tipiṭaka—the Three Baskets of the Buddhist canon", some locales spaced
const [homeRoot, homeTranslation, ...rest] = t(userLanguage, 'home:1').split(
  /\s*—\s*/
)
const homeIsPair = !!homeTranslation && !rest.length
---

<Layout jsonLd={jsonLd} title={t(userLanguage, 'home:1')}>
  <main id="main">
    {
      homeIsPair ? (
        <h1>
          <RootTitle root={homeRoot} translation={homeTranslation} lang="pli" />
        </h1>
      ) : (
        <h1 set:html={t(userLanguage, 'home:1')} />
      )
    }
    <ol>
      {
        tipitakaData.map(pitaka => (
          <li>
            <article>
              <h2>
                <RootTitle
                  root={pitaka.root_name}
                  translation={pitaka.translated_name}
                  href={`/pitaka/${pitaka.uid}`}
                />
              </h2>
              {!!pitaka.blurb && <p set:html={pitaka.blurb} />}
            </article>
          </li>
        ))
      }
    </ol>
  </main>
</Layout>

<style>
  ol {
    list-style-type: upper-roman;
  }
</style>
