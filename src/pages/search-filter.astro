---
import SearchFilterContent from '~/components/search-filter-content.astro'
import SearchForm from '~/components/search-form.astro'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'

const userLanguage = Astro.locals.userLanguage

const title = t(userLanguage, 'interface:searchFilter')
---

<Layout title={title}>
  <main id="main">
    <article>
      <SearchForm />
      <SearchFilterContent />
    </article>
  </main>
</Layout>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
