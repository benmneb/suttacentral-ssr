---
import '~/assets/offline-icons.css'
import Icon from '~/components/icon.astro'
import { SC_ORIGIN } from '~/constants/urls'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import { sitePageMetadata } from '~/utils/json-ld'

const userLanguage = Astro.locals.userLanguage

const title = t(userLanguage, 'interface:offlineTitle')

const scxStaticReleases =
  'https://codeberg.org/benmneb/suttacentral-static/releases/latest'
---

<Layout {...sitePageMetadata(userLanguage, '/offline', title)}>
  <main id="main">
    <article>
      <h1>{title}</h1>
      <h2>SuttaCentral</h2>
      <ul>
        <li>
          <a href={`${SC_ORIGIN}/offline`} rel="external">
            <Icon name="devicePhoneMobile" />
            {t(userLanguage, 'offline:webApp')}
          </a>
          <p>{t(userLanguage, 'offline:webAppDescription')}</p>
        </li>
        <li>
          <a href="/editions">
            <Icon name="bookOpen" />
            {t(userLanguage, 'publication:editionsToolbarTitle')}
          </a>
          <p>{t(userLanguage, 'offline:editionsDescription')}</p>
        </li>
      </ul>
      <h2 id="scx-offline">SuttaCentral Express</h2>
      <ul>
        <li>
          <a href={scxStaticReleases}>
            <Icon name="archiveBoxArrowDown" />
            {t(userLanguage, 'offline:siteArchive')}
          </a>
          <p>{t(userLanguage, 'offline:siteArchiveDescription')}</p>
        </li>
        <li>
          <a href={scxStaticReleases}>
            <Icon name="computerDesktop" />
            {t(userLanguage, 'offline:nativeApps')}
          </a>
          <p>{t(userLanguage, 'offline:nativeAppsDescription')}</p>
        </li>
        <li>
          <a href={scxStaticReleases}>
            <Icon name="documentArrowDown" />
            {t(userLanguage, 'offline:kiwixZim')}
          </a>
          <p
            set:html={t(userLanguage, 'offline:kiwixZimDescription', {
              kiwix: '<a href="https://kiwix.org" rel="external">Kiwix</a>',
            })}
          />
        </li>
      </ul>
    </article>
  </main>
</Layout>

<style>
  ul {
    list-style: none;
    padding: 0;
  }

  li + li {
    margin-top: 1rem;
  }

  /* Flex drops the markup's spaces, so the underline stops at the words */
  a {
    display: inline-flex;
    align-items: center;
  }

  a > :global(.icon:first-child) {
    margin-inline-end: 0.375rem;
  }

  p {
    margin: 0;
    padding-inline-start: calc(1em + 0.375rem);
    color: var(--text-color-secondary);
  }
</style>
