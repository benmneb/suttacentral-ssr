---
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import { sitePageMetadata } from '~/utils/json-ld'

const userLanguage = Astro.locals.userLanguage

const title = t(userLanguage, 'interface:licensingTitle')
---

<Layout {...sitePageMetadata(userLanguage, '/licensing', title)}>
  <main id="main">
    <article>
      <h1 set:html={t(userLanguage, 'licensing:1')} />
      <p set:html={t(userLanguage, 'licensing:2')} />
      <p set:html={t(userLanguage, 'licensing:3')} />
      <p set:html={t(userLanguage, 'licensing:4')} />
      <h2 set:html={t(userLanguage, 'licensing:5')} />
      <p set:html={t(userLanguage, 'licensing:6')} />
      <p set:html={t(userLanguage, 'licensing:7')} />
      <p set:html={t(userLanguage, 'licensing:8')} />
      <p set:html={t(userLanguage, 'licensing:9')} />
      <ul>
        <li set:html={t(userLanguage, 'licensing:10')} />
        <li set:html={t(userLanguage, 'licensing:11')} />
      </ul>
      <p set:html={t(userLanguage, 'licensing:12')} />
      <h2 set:html={t(userLanguage, 'licensing:13')} />
      <p set:html={t(userLanguage, 'licensing:14')} />
      <p set:html={t(userLanguage, 'licensing:15')} />
      <ul>
        <li>
          <span set:html={t(userLanguage, 'licensing:16')} />
          <a
            href="https://creativecommons.org/licenses/by/3.0/us/"
            rel="external noreferrer"
          >
            Creative Commons Attribution (CC BY 3.0 US)
          </a>
          <span set:html={t(userLanguage, 'licensing:18')} />
          <ul>
            <li set:html={t(userLanguage, 'licensing:19')} />
            <li set:html={t(userLanguage, 'licensing:20')} />
            <li set:html={t(userLanguage, 'licensing:21')} />
          </ul>
        </li>
      </ul>
      <h2 set:html={t(userLanguage, 'licensing:23')} />
      <p set:html={t(userLanguage, 'licensing:24')} />
      <p set:html={t(userLanguage, 'licensing:25')} />
      <h2 set:html={t(userLanguage, 'licensing:26')} />
      <p set:html={t(userLanguage, 'licensing:27')} />
    </article>
  </main>
</Layout>
