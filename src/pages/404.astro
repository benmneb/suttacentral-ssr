---
import Icon from '~/components/icon.astro'
import { siteMetaData } from '~/constants/meta-data'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
const userLanguage = Astro.locals.userLanguage
---

<Layout title={t(userLanguage, 'error:pageNotFound')}>
  <main id="main">
    <h1>{t(userLanguage, 'error:pageNotFound')}</h1>
    <ul>
      <li>
        <a class="with-icon" href="/">
          <Icon name="home" />
          <span>{t(userLanguage, 'error:goHome')}</span>
        </a>
      </li>
      <li>
        <a class="with-icon" href="/search">
          <Icon name="magnifyingGlass" />
          <span>{t(userLanguage, 'error:searchForSomething')}</span>
        </a>
      </li>
      <li>
        <a class="with-icon" href={siteMetaData.feedback}>
          <Icon name="flag" />
          <span>{t(userLanguage, 'error:reportMissingPage')}</span>
        </a>
      </li>
    </ul>
  </main>
</Layout>

<style>
  ul {
    padding: 0;
  }

  li {
    list-style: none;
    margin: 0.5rem 0;
  }

  a > :global(.icon) {
    color: inherit;
  }
</style>
