---
import '~/assets/search.css'
import LazyParallels from '~/components/lazy-parallels.astro'
import RootTitle from '~/components/root-title.astro'
import SearchForm from '~/components/search-form.astro'
import TextMetaContent from '~/components/text-meta-content.astro'
import { dictionaryTitles } from '~/constants/define'
import { expansionData } from '~/constants/expansion'
import Icon from '~/components/icon.astro'
import { siteMap } from '~/constants/static-pages'
import { SC_API, SC_ORIGIN } from '~/constants/urls'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import {
  getSearchLanguages,
  getSearchStarts,
  setSearchLanguages,
  setSearchStarts,
} from '~/utils/cookies'
import { getAllPreferredLanguages } from '~/utils/language'
import { getLanguages } from '~/utils/languages'
import { expandUid } from '~/utils/strings'

const { searchParams } = Astro.url
const acceptLanguage = Astro.request.headers.get('accept-language')
const userLanguage = Astro.locals.userLanguage

const langData = await getLanguages()

const userLanguages = getAllPreferredLanguages(acceptLanguage)

const defaultLanguages = langData
  .filter(
    (l: { is_root: boolean; iso_code: string }) =>
      l.is_root || userLanguages.includes(l.iso_code)
  )
  .map((l: { uid: string }) => l.uid)
  .sort()

const query = searchParams.get('query')
const matchPartial = searchParams.get('matchpartial') === 'true'
const urlLanguages = searchParams.getAll('languages')

// If languages in URL, save to session cookie and redirect to clean URL
if (urlLanguages.length > 0) {
  setSearchLanguages(Astro.cookies, urlLanguages)
  const cleanUrl = new URL(Astro.url)
  cleanUrl.searchParams.delete('languages')
  return Astro.redirect(cleanUrl.toString())
}

const languageArray = getSearchLanguages(Astro.cookies) ?? defaultLanguages

const limit = 50 // SC default (apparently limiting something other than the results count)
const page = Number(searchParams.get('page')) || 1
const offset = (page - 1) * limit

let hits = []
let dictionaryHits = []
let suttaplex = []
let hasMore = false
let hasPrevious = false
let searchData = { total: 0 }

let searchFailed = false

// The API fails some queries, eg "greed AND desire"
if (query) {
  try {
    const searchResponse = await fetch(
      `${SC_API}/search/instant?limit=${limit}&offset=${offset}&query=${encodeURIComponent(query)}&language=${userLanguage}&restrict=all&matchpartial=${matchPartial}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(languageArray),
        signal: AbortSignal.timeout(20_000),
      }
    )
    if (!searchResponse.ok) {
      throw new Error(`Search API returned ${searchResponse.status}`)
    }
    searchData = await searchResponse.json()

    hits = searchData.hits.filter(h => h.category !== 'dictionary')
    dictionaryHits = searchData.hits.filter(h => h.category === 'dictionary')
    suttaplex = searchData.suttaplex ?? []

    // The authors list comes whole on every page
    hasMore = searchData.total > page * limit && query !== 'list authors'
    hasPrevious = page > 1
  } catch (e) {
    console.error(`Search failed for "${query}":`, e)
    searchFailed = true
    searchData = { total: 0 }
    hits = dictionaryHits = suttaplex = []
  }
}

function fold(text: string) {
  return text.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim()
}

const foldedQuery = fold(query ?? '')
const pageHits =
  page === 1 && foldedQuery.length >= 3
    ? siteMap
        .map(({ label, pages }) => {
          const group = t(userLanguage, label)
          const groupMatches = fold(group).includes(foldedQuery)
          return {
            group,
            pages: pages
              .map(p => ({ href: p.href, text: t(userLanguage, p.label) }))
              .filter(p => groupMatches || fold(p.text).includes(foldedQuery)),
          }
        })
        .filter(({ pages }) => pages.length)
    : []

const split = !!hits.length && query !== 'list authors'
const cardsPerPage = limit / 2

// Rough heights in lines of a 600px column, so the cards can stop short of the hits
function textLines(html: string | undefined, perLine: number) {
  return Math.ceil((html ?? '').replace(/<[^>]*>/g, '').length / perLine)
}

function hitLines(hit) {
  const refs = hit.all_reference?.includes('pts-') ? 1 : 0
  return 5.7 + textLines(hit.highlight.content.join(''), 58) + refs
}

function dictionaryLines(hit) {
  const { definition, text, grammar, xr, pronunciation } =
    hit.highlight.detail[0]
  const definitions = [definition, text].flat().filter(Boolean)
  return (
    7 +
    definitions.reduce((n, d) => n + textLines(d, 55), 0) +
    [grammar, xr, pronunciation].filter(Boolean).length
  )
}

function cardLines(entry) {
  const { translations, root_lang, blurb, type } = entry
  const ownLanguage = translations.filter(t => t.lang === userLanguage).length
  const roots = translations.filter(t => t.lang === root_lang).length
  const lists = translations.length ? 5.1 + ownLanguage + roots : 0
  const parallels = type === 'leaf' ? (translations.length ? 1.7 : 6) : 0
  return 7.3 + (blurb ? 0.7 + textLines(blurb, 55) : 0) + lists + parallels
}

// The API merges hits after paging, so where each page starts is kept in a cookie
const search = JSON.stringify([query, matchPartial, languageArray])
const { starts, cards } = getSearchStarts(Astro.cookies, search) ?? {
  starts: [1],
  cards: [0],
}
for (let i = starts.length; i < page; i++) {
  starts.push(i * limit + 1)
  cards.push(i * cardsPerPage)
}
const start = starts[page - 1]
const digits = String(start + hits.length - 1).length

const cardStart = cards[page - 1]
let cardEnd = cardStart + cardsPerPage
if (split) {
  let room =
    hits.reduce((n, hit) => n + hitLines(hit), 0) -
    (pageHits.length ? 4.6 + pageHits.length : 0) -
    (page === 1
      ? dictionaryHits.reduce((n, hit) => n + dictionaryLines(hit), 0)
      : 0)
  cardEnd = cardStart
  while (cardEnd < suttaplex.length) {
    room -= cardLines(suttaplex[cardEnd])
    if (room < 0) break
    cardEnd++
  }
}
const suttaplexHits = suttaplex.slice(cardStart, cardEnd)

if (hasMore) {
  starts[page] = start + hits.length
  cards[page] = cardStart + suttaplexHits.length
  setSearchStarts(Astro.cookies, search, { starts, cards })
}
---

<Layout title={query || t(userLanguage, 'search:search')} noindex>
  <span id="main" tabindex="-1"></span>
  <main>
    <hgroup>
      <h1>{t(userLanguage, 'search:search')}</h1>
      {
        query &&
          (searchFailed ? (
            <p>
              {t(userLanguage, 'search:failedFor')} <b>{query}</b>
            </p>
          ) : (
            <p>
              {searchData.total.toLocaleString()}
              {t(userLanguage, 'search:resultsFor')}
              <b>{query}</b>
            </p>
          ))
      }
    </hgroup>
    <SearchForm
      matchPartial={matchPartial}
      query={query}
      autoFocus={!query || !searchData.total}
      languageArray={languageArray}
    />
    {
      query && !searchFailed && (
        <>
          <section class:list={[split && 'split']}>
            {query === 'list authors' ? (
              <ol start={start} style={`--digits: ${digits}`}>
                {hits.map(hit => (
                  <li>
                    <hgroup>
                      <h2>
                        <a
                          href={`/search?query=${encodeURIComponent(`by:${hit.author_uid}`)}`}
                        >
                          {hit.author}
                        </a>
                      </h2>
                      <p>{hit.author_uid}</p>
                    </hgroup>
                  </li>
                ))}
              </ol>
            ) : (
              <>
                {(!!pageHits.length ||
                  (!!dictionaryHits.length && page === 1)) && (
                  <ol class="featured-hits">
                    {!!pageHits.length && (
                      <li class="page-hits">
                        <h2>{t(userLanguage, 'interface:sitePages')}</h2>
                        <ul>
                          {pageHits.map(({ group, pages }) => (
                            <li>
                              <span>{group}</span>
                              <ul>
                                {pages.map(({ href, text }) => (
                                  <li>
                                    <a href={href}>{text}</a>
                                  </li>
                                ))}
                              </ul>
                            </li>
                          ))}
                        </ul>
                      </li>
                    )}
                    {!!dictionaryHits.length &&
                      page === 1 &&
                      dictionaryHits.map(hit => (
                        <li class="dictionary-hit">
                          <p>
                            <small>
                              {
                                dictionaryTitles?.[
                                  hit.highlight.detail[0].dictname
                                ]
                              }
                            </small>
                          </p>
                          <dl>
                            <dt>{hit.highlight.detail[0].word}</dt>
                            <dd />
                            {hit.highlight.detail[0].grammar && (
                              <dd>
                                <em>{hit.highlight.detail[0].grammar}</em>
                              </dd>
                            )}
                            {hit.highlight.detail[0].text && (
                              <dd
                                set:html={hit.highlight.detail[0].text.replaceAll(
                                  SC_ORIGIN,
                                  ''
                                )}
                              />
                            )}
                            {hit.highlight.detail[0].definition && (
                              <dd>
                                {Array.isArray(
                                  hit.highlight.detail[0].definition
                                ) ? (
                                  <ol>
                                    {hit.highlight.detail[0].definition.map(
                                      d => (
                                        <li set:html={d} />
                                      )
                                    )}
                                  </ol>
                                ) : (
                                  hit.highlight.detail[0].definition
                                )}
                              </dd>
                            )}
                            {hit.highlight.detail[0].xr && (
                              <dd>
                                <ul>
                                  {Array.isArray(hit.highlight.detail[0].xr) ? (
                                    <>
                                      {hit.highlight.detail[0].xr.map(d => (
                                        <li>
                                          <a href={`/define/${d}`}>{d}</a>
                                        </li>
                                      ))}
                                    </>
                                  ) : (
                                    <li>
                                      <a
                                        href={`/define/${hit.highlight.detail[0].xr}`}
                                      >
                                        {hit.highlight.detail[0].xr}
                                      </a>
                                    </li>
                                  )}
                                </ul>
                              </dd>
                            )}
                            {hit.highlight.detail[0].pronunciation && (
                              <dd>
                                <strong>
                                  {t(userLanguage, 'dictionary:pronunciation')}
                                </strong>{' '}
                                {hit.highlight.detail[0].pronunciation}
                              </dd>
                            )}
                          </dl>
                          <p>
                            <a class="with-icon" href={hit.url}>
                              <span>
                                {t(userLanguage, 'search:all')}{' '}
                                {t(userLanguage, 'search:dictionaries')}
                              </span>
                              <Icon name="arrowRight" />
                            </a>
                          </p>
                        </li>
                      ))}
                  </ol>
                )}
                {!!hits.length && (
                  <ol
                    class="text-hits"
                    start={start}
                    style={`--digits: ${digits}`}
                  >
                    {hits.map(hit => (
                      <li>
                        <hgroup>
                          <h2>
                            {hit.is_article ? (
                              <a href={hit.url}>{hit.heading.title}</a>
                            ) : (
                              <RootTitle
                                root={hit.root_name}
                                translation={hit.name || hit.heading?.title}
                                lang={hit.root_lang}
                                href={hit.url}
                              />
                            )}
                          </h2>
                          <p>
                            {[
                              hit.acronym || expandUid(hit.uid, expansionData),
                              hit.full_lang,
                              hit.author,
                            ]
                              .filter(Boolean)
                              .join(' ∙ ')}
                          </p>
                        </hgroup>
                        {hit.highlight.content.map((excerpt: string) => (
                          <span
                            set:html={excerpt
                              .replaceAll('target="_blank"', '')
                              .replace(/\sid="[^"]*"/g, '')}
                          />
                        ))}
                        {hit.all_reference
                          ?.split(',')
                          .filter(r => r.includes('pts-'))
                          .map((ref: string, idx: number, arr: string[]) =>
                            // prettier-ignore
                            <span>
                            <a href={`${hit.url}/en/sujato#${ref.trim()}`}>{ref}</a>
                            {idx !== arr.length - 1 && '∙ '}
                          </span>
                          )}
                      </li>
                    ))}
                  </ol>
                )}
                {!!suttaplexHits.length && (
                  <ol class="suttaplex-hits">
                    {suttaplexHits.map(entry => (
                      <li>
                        <TextMetaContent
                          data={entry}
                          userLanguage={userLanguage}
                          headingLevel={2}
                          lazyParallels
                        />
                      </li>
                    ))}
                  </ol>
                )}
              </>
            )}
          </section>
          <nav aria-label={t(userLanguage, 'search:pagination')}>
            {hasPrevious && (
              <form method="GET" action="/search">
                <input type="hidden" name="query" value={query} />
                <input type="hidden" name="page" value={page - 1} />
                {matchPartial && (
                  <input type="hidden" name="matchpartial" value="true" />
                )}
                <button class="button" type="submit">
                  <Icon name="arrowLeft" />
                  <span>{t(userLanguage, 'interface:previous')}</span>
                </button>
              </form>
            )}
            {hasMore && (
              <form method="GET" action="/search">
                <input type="hidden" name="query" value={query} />
                <input type="hidden" name="page" value={page + 1} />
                {matchPartial && (
                  <input type="hidden" name="matchpartial" value="true" />
                )}
                <button class="button" type="submit">
                  <span>{t(userLanguage, 'interface:next')}</span>
                  <Icon name="arrowRight" />
                </button>
              </form>
            )}
          </nav>
        </>
      )
    }
  </main>
  {!!suttaplexHits.length && <LazyParallels />}
</Layout>

<style>
  main {
    max-width: var(--content-double-width-gap);

    @media (min-width: 672px) {
      & > :global(form[role='search']) {
        --bar-width: min(var(--content-max-width), calc((100% - 1rem) / 2));
      }
    }

    & > section {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      margin-top: 1rem;

      @media (min-width: 672px) {
        grid-template-columns: repeat(2, minmax(0, 1fr));

        &:not(.split) > * {
          grid-column: 1;
        }

        &.split {
          grid-template-rows: auto 1fr;
          grid-template-areas:
            'texts featured'
            'texts suttaplex';

          .text-hits {
            grid-area: texts;
          }

          .featured-hits {
            grid-area: featured;
          }

          .suttaplex-hits {
            grid-area: suttaplex;
          }

          .featured-hits ~ .suttaplex-hits {
            margin-top: 0;
          }

          .featured-hits,
          .suttaplex-hits {
            padding-left: 3ch;
          }
        }
      }

      .featured-hits {
        margin-bottom: 0;

        & + .suttaplex-hits {
          margin-top: 0;
        }
      }

      ol {
        min-width: 0;
        max-width: var(--content-max-width);
        overflow-wrap: break-word;
        padding-left: calc(var(--digits, 2) * 1ch + 1ch);

        li:first-of-type h2 {
          margin-top: 0;
        }

        &.featured-hits,
        &.suttaplex-hits {
          list-style-type: none;
          padding-left: 0;
        }

        &.suttaplex-hits {
          & > li {
            border: 1px solid;
            border-color: var(--bg-alt-1);
            border-radius: var(--rounding);
            padding: 1rem;

            &:not(li:first-of-type) {
              margin-top: 1rem;
            }
          }
        }
      }

      .page-hits {
        border: 1px solid var(--bg-alt-3);
        border-radius: var(--rounding);
        padding: 1rem;
        margin-bottom: 1rem;

        h2 {
          font-size: inherit;
          color: var(--text-color-secondary);
        }

        ul {
          list-style: none;
          margin: 0;
          padding: 0;
        }

        & > ul > li {
          display: flex;
          align-items: baseline;
        }

        li > span {
          flex-shrink: 0;
          color: var(--text-color-secondary);

          &::after {
            content: '/';
            content: '/' / '';
            margin-inline: 0.5rem;
            color: var(--gray);
          }
        }

        ul ul {
          display: flex;
          flex-wrap: wrap;

          /* Flex, so the space after the link is not set before the ∙ */
          li {
            display: flex;
            align-items: baseline;
          }

          li:not(:last-child)::after {
            content: '∙';
            content: '∙' / '';
            margin-inline: 0.4rem;
            color: var(--gray);
          }
        }

        /* Flex drops the markup's spaces, so the underline stops at the words */
        a {
          display: inline-flex;
          align-items: center;
        }
      }

      .dictionary-hit {
        border: 1px solid;
        border-radius: var(--rounding);
        border-color: var(--bg-alt-3);
        padding: 1rem;
        margin-bottom: 1rem;
        list-style: none;

        > p:first-of-type {
          margin-top: 0;
        }
        > p:last-of-type {
          margin-bottom: 0;
        }
      }
    }

    & > nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1rem;
      margin-left: 1.5rem;
    }
  }
</style>
