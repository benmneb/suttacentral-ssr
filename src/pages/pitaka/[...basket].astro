---
import FurtherReading from '~/components/further-reading.astro'
import RootTitle from '~/components/root-title.astro'
import * as heroicon from '~/constants/heroicons'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import { fetchEditions } from '~/utils/editions'
import { generatePitakaJsonLd } from '~/utils/json-ld'
import { getLanguageName } from '~/utils/language'

const { pathname } = Astro.url
const uid = pathname?.split('/').pop()?.toLowerCase()

const userLanguage = Astro.locals.userLanguage

const menuResponse = await fetch(
  `https://suttacentral.net/api/menu/${uid}?language=${userLanguage}`
)
const menuDataJson = await menuResponse.json()
let menuData = menuDataJson[0]

if (!menuData.uid) {
  Astro.response.status = 404
  Astro.response.statusText = 'Menu UID not found'
  return Astro.rewrite('/404')
}

const newKids = await Promise.all(
  menuData.children.map(async child => {
    const response = await fetch(
      `https://suttacentral.net/api/menu/${child.uid}?language=${userLanguage}`
    )
    const json = await response.json()
    const childData = json[0]

    const hasBranchChildren = childData.children?.some(
      gc => gc.node_type === 'branch'
    )
    const isPatimokkha = child.uid.endsWith('-pm')

    if (!hasBranchChildren || isPatimokkha) {
      return { ...child, _scx_href: `/${child.uid}` }
    }
    return child
  })
)
menuData.children = newKids

const [crumbsData, shortcutsData, editions] = await Promise.all([
  fetch(
    `https://suttacentral.net/api/navigation_data/${uid}?language=${userLanguage}`
  ).then(r => r.json()),
  fetch(`https://suttacentral.net/api/shortcuts`).then(r => r.json()),
  fetchEditions(
    [menuData.uid, ...menuData.children.map(child => child.uid)],
    userLanguage
  ),
])

const origin = Astro.site?.origin ?? ''
const jsonLd = generatePitakaJsonLd(menuData, crumbsData, origin)

const userLanguageName = getLanguageName(userLanguage)

// A language code Intl doesnt know would throw
let numberFormat: Intl.NumberFormat
try {
  numberFormat = new Intl.NumberFormat(userLanguage)
} catch {
  numberFormat = new Intl.NumberFormat()
}

// Like .net's card header, eg "SN 1–11 ∙ Pāli → 657 English"
function cardDetails(child: any) {
  const count =
    child.yellow_brick_road &&
    numberFormat.format(child.yellow_brick_road_count)
  return {
    range: child.child_range,
    root: child.root_lang_name,
    translated: count && `${count} ${userLanguageName}`,
    spoken:
      count &&
      t(userLanguage, 'interface:translationCount', {
        language: userLanguageName,
        count,
      }),
  }
}
---

<Layout
  title={`${menuData.root_name}${menuData.root_name && menuData.translated_name ? '—' : ''}${menuData.translated_name || ''}`}
  description={menuData.blurb?.replace(/<[^>]*>/g, '')}
  breadcrumbs={crumbsData}
  jsonLd={jsonLd}
>
  <main>
    <h1>
      <RootTitle
        root={menuData.root_name}
        translation={menuData.translated_name}
        lang={menuData.root_lang_iso}
      />
    </h1>
    {!!menuData.blurb && <p set:html={menuData.blurb} />}
    {
      shortcutsData?.[0]?.shortcuts?.includes(uid) && (
        <p>
          <a class="with-icon" href={`/${uid}`}>
            <span>{t(userLanguage, 'interface:shortcutToFullList')}</span>
            <Fragment set:html={heroicon.arrowRight} />
          </a>
        </p>
      )
    }
    <FurtherReading
      uid={menuData.uid}
      edition={editions.get(menuData.uid)}
      userLanguage={userLanguage}
    />
    <ol>
      {
        menuData.children.map(child => {
          const { range, root, translated, spoken } = cardDetails(child)
          return (
            <li>
              <hgroup>
                <h2>
                  <RootTitle
                    root={child.root_name}
                    translation={child.translated_name}
                    lang={child.root_lang_iso}
                    href={child._scx_href ?? `${menuData.uid}/${child.uid}`}
                  />
                </h2>
                {(!!range || !!root || !!translated) && (
                  <p class="card-details">
                    {!!range && <span class="range">{range}</span>}
                    {!!root && <span>{root}</span>}
                    {!!root && !!translated && (
                      <Fragment set:html={heroicon.arrowRight} />
                    )}
                    {!!translated && (
                      <>
                        <span aria-hidden="true">{translated}</span>
                        <span class="sr-only">{spoken}</span>
                      </>
                    )}
                  </p>
                )}
              </hgroup>
              {!!child.blurb && <p set:html={child.blurb} />}
              {shortcutsData?.[0]?.shortcuts?.includes(child.uid) && (
                <p>
                  <a class="with-icon" href={`/${child.uid}`}>
                    <span>
                      {t(userLanguage, 'interface:shortcutToFullList')}
                    </span>
                    <Fragment set:html={heroicon.arrowRight} />
                  </a>
                </p>
              )}
              <FurtherReading
                uid={child.uid}
                edition={editions.get(child.uid)}
                userLanguage={userLanguage}
              />
            </li>
          )
        })
      }
    </ol>
  </main>
</Layout>

<style>
  ol {
    list-style-type: upper-roman;
  }

  hgroup:has(p) {
    h2 {
      margin-bottom: 0.4rem;
    }

    p {
      margin-top: 0;
      color: var(--text-color-secondary);
    }
  }

  .card-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    .range:not(:last-child)::after {
      content: '∙';
      content: '∙' / '';
      margin-inline: 0.5em;
    }

    > :global(.icon) {
      margin-inline: 0.5em;
    }
  }
</style>
