---
import FurtherReading from '~/components/further-reading.astro'
import LazyParallels from '~/components/lazy-parallels.astro'
import TextMetaContent from '~/components/text-meta-content.astro'
import { SC_API } from '~/constants/urls'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'
import { fetchEditions } from '~/utils/editions'
import { chapterMetadata, suttaplexMetadata } from '~/utils/json-ld'
import { softHyphenateTitle, uidToAcronym } from '~/utils/strings'

const { chapter } = Astro.params
const userLanguage = Astro.locals.userLanguage

const lowerChapter = chapter?.toLowerCase()

async function fetchCrumbs(uid: string | undefined) {
  const r = await fetch(
    `${SC_API}/navigation_data/${uid}?language=${userLanguage}`
  )
  return r.json()
}

async function fetchShortcuts(): Promise<string[]> {
  const r = await fetch(`${SC_API}/shortcuts`)
  return (await r.json())?.[0]?.shortcuts ?? []
}

// A branch's crumbs end with the branch itself, a leaf's with its parent
// chapter. So a branch can fetch its parent's menu, which holds its siblings
// for prev/next, alongside the suttaplex rather than after it
async function fetchSiblings() {
  const crumbs = await crumbsPromise
  const parentUid = crumbs.at(-1)?.uid === lowerChapter && crumbs.at(-2)?.uid
  return parentUid ? fetchChildren(parentUid) : []
}

async function fetchChildren(uid: string) {
  const r = await fetch(`${SC_API}/menu/${uid}?language=${userLanguage}`)
  return (await r.json())?.[0]?.children ?? []
}

const fetchesLeft = new AbortController()
const { signal } = fetchesLeft
const suttaplexPromise = fetch(
  `${SC_API}/suttaplex/${lowerChapter}?language=${userLanguage}`,
  { signal }
).then(r => r.json())
// The test text-meta-content shows parallels by, so none are fetched unused
const parallelsPromise = suttaplexPromise.then(data => {
  const entries = data?.filter?.(entry => entry?.uid) ?? []
  const [entry] = entries
  const showsParallels =
    entries.length === 1 &&
    (entry.type === 'leaf' ||
      (entry.uid.startsWith('pli-tv-') && !!entry.parallel_count))
  return showsParallels
    ? fetch(`${SC_API}/parallels/${entry.uid}`, { signal }).then(r => r.json())
    : undefined
})
const crumbsPromise = fetchCrumbs(lowerChapter)
const editionsPromise = fetchEditions([lowerChapter], userLanguage, { signal })
let [crumbsData, shortcuts] = await Promise.all([
  crumbsPromise,
  fetchShortcuts(),
])

// A full list like /sn is too big for a Worker, so it goes to its menu page
const ownCrumb = crumbsData.at(-1)
if (
  ownCrumb?.uid === lowerChapter &&
  ownCrumb.url?.startsWith('/pitaka/') &&
  !shortcuts.includes(lowerChapter!)
) {
  parallelsPromise.catch(() => {})
  fetchesLeft.abort()
  return Astro.redirect(ownCrumb.url, 302)
}

let [suttaplexData, siblings, editions, parallelsData] = await Promise.all([
  suttaplexPromise,
  fetchSiblings(),
  editionsPromise,
  parallelsPromise,
])
let isIndividualRangeSutta = false

if (!suttaplexData?.[0]?.uid) {
  const rangeSuttaplexResponse = await fetch(
    `${SC_API}/range_suttaplex/${lowerChapter}?language=${userLanguage}`
  )
  const rangeSuttaplexData = await rangeSuttaplexResponse.json()
  if (rangeSuttaplexData?.[0]?.uid) {
    suttaplexData = rangeSuttaplexData
    isIndividualRangeSutta = true
  } else {
    Astro.response.status = 404
    Astro.response.statusText = 'Suttaplex UID not found'
    return Astro.rewrite('/404')
  }
}

// The api lists an empty entry among some chapters' texts, eg lzh-mu-bi-vb-pd's
suttaplexData = suttaplexData.filter(entry => entry?.uid)
// And calls those chapters leaves while listing their texts, so their crumbs
// end with the parent, as a text's do
if (suttaplexData.length > 1 && suttaplexData[0].type === 'leaf') {
  const chapterEntry = suttaplexData[0]
  suttaplexData[0] = { ...chapterEntry, type: 'branch' }
  const parentUid = crumbsData.at(-1)?.uid
  if (parentUid) siblings = await fetchChildren(parentUid)
  crumbsData = [
    ...crumbsData,
    {
      uid: lowerChapter,
      title: chapterEntry.original_title || chapterEntry.acronym,
      url: `/${lowerChapter}`,
    },
  ]
}

// The range's own uid has no crumbs, only the range it belongs to
if (isIndividualRangeSutta) crumbsData = await fetchCrumbs(suttaplexData[0].uid)
const modifiedCrumbsData = [
  ...crumbsData,
  ...(suttaplexData.length === 1
    ? [
        {
          uid: lowerChapter,
          title: isIndividualRangeSutta
            ? uidToAcronym(lowerChapter!)
            : suttaplexData[0].acronym,
        },
      ]
    : []),
]

// The api leaves previous/next empty on branches, so a chapter finds its
// neighbours among its parent's children instead
let previous = suttaplexData[0]?.previous
let next = suttaplexData[0]?.next
if (!previous?.uid && !next?.uid) {
  const index = siblings.findIndex(sibling => sibling.uid === lowerChapter)
  const toLink = sibling =>
    sibling && {
      uid: sibling.uid,
      name: sibling.translated_name?.trim() || sibling.root_name,
    }
  if (index > -1) {
    previous = toLink(siblings[index - 1])
    next = toLink(siblings[index + 1])
  }
}

const isPatimokkha = lowerChapter?.endsWith('-pm')
const isList = suttaplexData.length > 1

const metadata =
  suttaplexData.length === 1
    ? suttaplexMetadata(
        userLanguage,
        suttaplexData[0],
        lowerChapter!,
        modifiedCrumbsData,
        isIndividualRangeSutta
      )
    : chapterMetadata(
        userLanguage,
        suttaplexData,
        lowerChapter!,
        modifiedCrumbsData
      )
---

<Layout {...metadata} breadcrumbs={modifiedCrumbsData}>
  <span id="content" tabindex="-1"></span>
  <main id="main">
    <ol>
      {
        (isPatimokkha ? [suttaplexData[0]] : suttaplexData).map((entry, i) => (
          <li
            class={
              (suttaplexData.length > 1 && entry.type === 'leaf') ||
              (entry.type === 'root' && !!entry.parallel_count)
                ? 'leaf-node'
                : ''
            }
          >
            <TextMetaContent
              data={entry}
              userLanguage={userLanguage}
              isIndividualRangeSutta={isIndividualRangeSutta}
              inRangeSuttaId={lowerChapter}
              lazyParallels={isList}
              parallelsData={parallelsData}
              parallelsId={isList ? undefined : 'parallels'}
            />
            {i === 0 && (
              <FurtherReading
                uid={lowerChapter}
                edition={editions.get(lowerChapter!)}
                userLanguage={userLanguage}
              />
            )}
          </li>
        ))
      }
      {
        isPatimokkha && (
          <details class="patimokkha-details">
            <summary>
              {t(userLanguage, 'interface:showParallelsAndDetails')}
            </summary>
            <ol>
              {suttaplexData.slice(1).map(entry => (
                <li class={entry.type === 'leaf' ? 'leaf-node' : ''}>
                  <TextMetaContent
                    data={entry}
                    userLanguage={userLanguage}
                    isIndividualRangeSutta={isIndividualRangeSutta}
                    inRangeSuttaId={lowerChapter}
                    lazyParallels={isList}
                  />
                </li>
              ))}
            </ol>
          </details>
        )
      }
    </ol>
  </main>
  <nav aria-label={t(userLanguage, 'interface:articlePagination')}>
    <div>
      {
        previous?.uid && (
          <>
            <span id="pagination-prev" aria-hidden="true">
              {t(userLanguage, 'interface:previous')}
            </span>
            <a
              href={`/${previous.uid}`}
              id="pagination-prev-link"
              rel="prev"
              aria-labelledby="pagination-prev pagination-prev-link"
            >
              {softHyphenateTitle(previous.name)}
            </a>
          </>
        )
      }
    </div>
    <div>
      {
        next?.uid && (
          <>
            <span id="pagination-next" aria-hidden="true">
              {t(userLanguage, 'interface:next')}
            </span>
            <a
              href={`/${next.uid}`}
              id="pagination-next-link"
              rel="next"
              aria-labelledby="pagination-next pagination-next-link"
            >
              {softHyphenateTitle(next.name)}
            </a>
          </>
        )
      }
    </div>
  </nav>
  {isList && <LazyParallels />}
</Layout>

<style>
  ol {
    padding: 0;
    list-style: none;
  }

  .patimokkha-details {
    margin-top: 1rem;

    > summary {
      cursor: pointer;
      padding: 0.5rem 0.15rem 0.5rem 0.5rem;
      border-radius: var(--rounding);
      margin-left: -0.5rem;
      background-color: var(--background-color-secondary);

      &:hover,
      &:active {
        background-color: var(--bg-alt-1);
      }
    }
  }

  main ~ nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-self: center;
    gap: 1rem;
    margin: 2rem 1rem;
    width: calc(100vw - 2rem);
    max-width: calc(var(--content-max-width) * 1.2);

    div {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
      overflow-wrap: anywhere;

      &:nth-of-type(2) {
        align-items: flex-end;
        text-align: right;
      }

      span {
        font-variant-caps: petite-caps;
      }
    }
  }
</style>
