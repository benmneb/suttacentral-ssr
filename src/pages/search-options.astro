---
import SearchForm from '~/components/search-form.astro'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'

const userLanguage = Astro.locals.userLanguage

const title = t(userLanguage, 'search:searchOptions')
---

<Layout title={title}>
  <span id="content" tabindex="-1"></span>
  <main id="main">
    <article>
      <SearchForm />
    </article>
  </main>
</Layout>
