---
import SearchForm from '~/components/search-form.astro'
import { t } from '~/i18n'
import Layout from '~/layouts/Layout.astro'

const userLanguage = Astro.locals.userLanguage

const title = t(userLanguage, 'search:searchOptions')
const crumbsData = [{ title }]
---

<Layout title={title} breadcrumbs={crumbsData}>
  <main>
    <article>
      <SearchForm />
    </article>
  </main>
</Layout>
