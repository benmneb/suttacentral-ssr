---
import '~/assets/define.css'
import { dictionaryTitles } from '~/constants/define'
import Icon from '~/components/icon.astro'
import MiniMap from '~/components/mini-map.astro'
import map from '~/constants/map.json'
import { SC_API, SC_ORIGIN } from '~/constants/urls'
import { t } from '~/i18n'
import { langTag } from '~/utils/language'
import { closeHeadingGaps, defineHref } from '~/utils/strings'
import Layout from '~/layouts/Layout.astro'
import { defineMetadata } from '~/utils/json-ld'

// Handle form submissions: /define/?term=X → /define/X
const queryTerm = Astro.url.searchParams.get('term')
if (queryTerm) {
  return Astro.redirect(defineHref(queryTerm))
}

const { term } = Astro.params
const userLanguage = Astro.locals.userLanguage

let dictionaryData = []
let similarData = [[]]
let adjacentData = [[]]

if (term) {
  ;[dictionaryData, similarData, adjacentData] = await Promise.all([
    fetch(`${SC_API}/dictionary_full/${term}?language=${userLanguage}`).then(
      r => r.json()
    ),
    fetch(`${SC_API}/dictionary_full/similar/${term}?language=${userLanguage}`)
      .then(r => r.json())
      .catch(() => [[]]),
    fetch(`${SC_API}/dictionary_full/adjacent/${term}?language=${userLanguage}`)
      .then(r => r.json())
      .catch(() => [[]]),
  ])
}

const places: Record<string, (typeof map.places)[keyof typeof map.places]> =
  map.places

// .net's map component, which a place's DPPN entry starts its first paragraph with, before a comma
const MAP_TAG = /(<p>)?<sc-map view='([^']*)'><\/sc-map>,?/

/** An entry's HTML either side of its map, with the place on the map, if it's there */
function splitAtMap(html: string) {
  const match = html.match(MAP_TAG)
  if (!match) return { before: html }
  const [tag, paragraph = '', view] = match
  return {
    before: html.slice(0, match.index),
    place: places[view],
    after: paragraph + html.slice(match.index! + tag.length),
  }
}

// Each id once on the page, as PTS gives each of a word's homonyms the word as its id, eg ambho
const ids = new Set<string>()

/** An entry's HTML with no type='α', which isn't a list type HTML has, no id already used and no heading gaps */
function tidyEntry(html: string) {
  return closeHeadingGaps(html)
    .replaceAll(SC_ORIGIN, '')
    .replaceAll(" type='α'", '')
    .replace(/ id=(['"])(.*?)\1/g, (match, _, id) =>
      ids.has(id) ? '' : (ids.add(id), match)
    )
}

/** The parts of an entry with a dd each, in order */
const PARTS = ['grammar', 'html', 'definition', 'xr', 'pronunciation'] as const

const entries = dictionaryData.map((entry, i) => {
  const parts = {
    ...entry,
    html: entry.text && splitAtMap(tidyEntry(entry.text)),
  }
  return {
    ...parts,
    // A dictionary's several entries under one dt, as a dl can't name two the same
    again: entry.dictname === dictionaryData[i - 1]?.dictname,
    first: PARTS.find(part => parts[part]),
  }
})

/** The class of an entry's first dd, if it's another of the dictionary above's entries */
const again = (entry: (typeof entries)[number], part: string) =>
  entry.again && entry.first === part ? 'again' : undefined

const dictionaries = new Set(dictionaryData.map(entry => entry.dictname)).size
const dictionaryCount = t(
  userLanguage,
  new Intl.PluralRules(langTag(userLanguage)).select(dictionaries) === 'one'
    ? 'dictionary:foundInDictionary'
    : 'dictionary:foundInDictionaries',
  { count: dictionaries.toLocaleString(langTag(userLanguage)) }
)
---

<Layout
  {...defineMetadata(userLanguage, term, dictionaryData, dictionaryTitles)}
  title={term
    ? `${t(userLanguage, 'dictionary:dictionaryResultsText')} ${term}`
    : t(userLanguage, 'interface:defineHeading')}
>
  <main id="main">
    {
      term ? (
        <hgroup>
          <h1>
            {t(userLanguage, 'dictionary:definitionsFor')}{' '}
            <span lang="pi" translate="no">
              {term}
            </span>
          </h1>
          <p>{dictionaryCount}</p>
        </hgroup>
      ) : (
        <h1>{t(userLanguage, 'interface:defineHeading')}</h1>
      )
    }
    <div>
      {
        !!dictionaryData.length && (
          <dl>
            {entries.map(entry => (
              <>
                {!entry.again && (
                  <dt>
                    {dictionaryTitles[entry.dictname] ?? entry.dictname}
                    {entry.dictname === 'dpd' && (
                      <>
                        {' '}
                        <a
                          href={`https://dpdict.net/?q=${term}`}
                          aria-label={t(userLanguage, 'dictionary:inDPD', {
                            term,
                          })}
                        />
                      </>
                    )}
                  </dt>
                )}
                {entry.grammar && (
                  <dd class={again(entry, 'grammar')}>
                    <em>{entry.grammar}</em>
                  </dd>
                )}
                {entry.html && (
                  <dd class={again(entry, 'html')}>
                    <Fragment set:html={entry.html.before} />
                    {entry.html.place && <MiniMap place={entry.html.place} />}
                    {entry.html.after && (
                      <Fragment set:html={entry.html.after} />
                    )}
                  </dd>
                )}
                {entry.definition && (
                  <dd class={again(entry, 'definition')}>
                    {Array.isArray(entry.definition) ? (
                      <ol>
                        {entry.definition.map(d => (
                          <li set:html={d} />
                        ))}
                      </ol>
                    ) : (
                      entry.definition
                    )}
                  </dd>
                )}
                {entry.xr && (
                  <dd class={again(entry, 'xr')}>
                    <ul>
                      {Array.isArray(entry.xr) ? (
                        <>
                          {entry.xr.map(d => (
                            <li>
                              <a href={defineHref(d)}>{d}</a>
                            </li>
                          ))}
                        </>
                      ) : (
                        <li>
                          <a href={defineHref(entry.xr)}>{entry.xr}</a>
                        </li>
                      )}
                    </ul>
                  </dd>
                )}
                {entry.pronunciation && (
                  <dd class={again(entry, 'pronunciation')}>
                    <strong>
                      {t(userLanguage, 'dictionary:pronunciation')}
                    </strong>{' '}
                    {entry.pronunciation}
                  </dd>
                )}
              </>
            ))}
          </dl>
        )
      }
      <nav aria-label={t(userLanguage, 'dictionary:otherWords')}>
        <form action="/define" method="get">
          <input
            type="search"
            name="term"
            required
            autofocus={!term}
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            placeholder={t(userLanguage, 'dictionary:searchPlaceholder')}
          />
          <button
            aria-label={t(userLanguage, 'dictionary:define')}
            type="submit"><Icon name="magnifyingGlass" mini /></button
          >
        </form>
        {
          !!adjacentData?.[0].length && !!dictionaryData.length && (
            <article>
              <h2>{t(userLanguage, 'dictionary:adjacentTerms')}</h2>
              <ol>
                {adjacentData[0].map(adjacentTerm =>
                  adjacentTerm === term ? (
                    <li class="no-list-item">
                      <span aria-current="page" lang="pi" translate="no">
                        {adjacentTerm}
                      </span>
                    </li>
                  ) : (
                    <li>
                      <a
                        href={defineHref(adjacentTerm)}
                        lang="pi"
                        translate="no"
                      >
                        {adjacentTerm}
                      </a>
                    </li>
                  )
                )}
              </ol>
            </article>
          )
        }
        {
          !!similarData?.[0].length && (
            <article>
              <h2>{t(userLanguage, 'dictionary:similarSpelling')}</h2>
              <ol>
                {similarData[0].map(similarTerm => (
                  <li>
                    <a href={defineHref(similarTerm)} lang="pi" translate="no">
                      {similarTerm}
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          )
        }
      </nav>
    </div>
  </main>
</Layout>

<style>
  main {
    max-width: calc(var(--content-max-width) + 30ch);

    > hgroup > h1 {
      color: var(--text-color);

      > span {
        color: var(--headings-color);
      }
    }

    & > div {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 1rem;

      @media (max-width: 600px) {
        grid-template-columns: 1fr;
      }

      & > dl {
        & > dt {
          font-weight: bold;
          margin-bottom: 0.4rem;

          > a {
            font-weight: initial;
          }
        }

        & > dd + dt,
        & > dd.again {
          margin-top: 1em;
        }
      }

      & > nav {
        position: sticky;
        top: 1rem;
        max-width: 30ch;

        h2 {
          overflow-wrap: break-word;
        }
      }
    }
  }

  form {
    display: flex;
    border: 1px solid;
    padding: 0.4rem;
    border-radius: var(--rounding);
    border-color: var(--text-color-secondary);

    &:focus-within {
      border-color: inherit;
      outline: var(--focus-ring);
      outline-offset: -1px;

      /* Forced colours repaint the border, and Highlight can be see-through */
      @media (forced-colors: active) {
        border-color: Canvas;
      }
    }

    input {
      width: 100%;
      border: none;
      background-color: inherit;
      color: inherit;
      font-size: inherit;

      &:focus {
        outline: none;
      }
    }

    button {
      border: none;
      background: none;
      font-size: inherit;
      cursor: pointer;
    }
  }

  .no-list-item {
    display: block;
  }
</style>
