---
import ParallelList from '~/components/parallel-list.astro'
import { t } from '~/i18n'
import { parallelHref, parallelKeyLabel } from '~/utils/parallels'

interface Props {
  id?: string
  segments: [string, any[]][] // from parallelSegments
  entry: { uid: string; acronym?: string; root_lang?: string } // the text the keys are from
  onScreenUid: string // what a key spanning two suttas points at instead
  rootTrans?: { lang: string; author_uid: string }
  userLanguage: string
}

const { id, segments, entry, onScreenUid, rootTrans, userLanguage } =
  Astro.props

const href = (segmentKey: string) =>
  parallelHref(segmentKey, onScreenUid, rootTrans!)
const label = (segmentKey: string) => parallelKeyLabel(segmentKey, entry)
---

<ul id={id}>
  {
    segments.length ? (
      segments.map(([segmentKey, parallels]) => (
        <li>
          {rootTrans ? (
            <a href={href(segmentKey)}>{label(segmentKey)}</a>
          ) : (
            <span>{label(segmentKey)}</span>
          )}
          <ParallelList
            parallels={parallels}
            rootLang={entry.root_lang}
            userLanguage={userLanguage}
          />
        </li>
      ))
    ) : (
      <li>{t(userLanguage, 'suttaplex:hasNoParallels')}</li>
    )
  }
</ul>
