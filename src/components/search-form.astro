---
import SearchFilterContent from '~/components/search-filter-content.astro'
import SearchOptionsContent from '~/components/search-options-content.astro'
import Icon from '~/components/icon.astro'
import { t } from '~/i18n'

interface Props {
  matchPartial?: boolean
  query?: string | null
  autoFocus?: boolean
  languageArray?: string[]
  inDialog?: boolean
}

const {
  matchPartial = false,
  query,
  autoFocus = true,
  languageArray,
  inDialog,
} = Astro.props
const pathname = Astro.url.pathname
const isSearchPage = pathname.startsWith('/search')

const userLanguage = Astro.locals.userLanguage
---

<form action="/search" method="get" role="search">
  <fieldset>
    <label for="search-input" class="sr-only"
      >{t(userLanguage, 'search:search')}</label
    >
    <input
      id="search-input"
      type="search"
      placeholder={`${t(userLanguage, 'search:search')}…`}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      name="query"
      required
      autofocus={autoFocus}
      value={query}
    />
    <button aria-label={t(userLanguage, 'search:search')} type="submit"
      ><Icon name="magnifyingGlass" mini /></button
    >
    {
      inDialog && (
        <button
          formmethod="dialog"
          formnovalidate
          aria-label={t(userLanguage, 'search:closeSearch')}
        >
          <Icon name="xMark" mini />
        </button>
      )
    }
  </fieldset>
  {
    isSearchPage && (
      <fieldset
        class:list={[
          pathname === '/search-filter' && 'without-filters',
          pathname === '/search-options' && 'without-languages',
          !!languageArray?.length && 'with-count',
        ]}
        style={
          languageArray?.length
            ? `--count-digits: ${String(languageArray.length).length}`
            : undefined
        }
      >
        <legend class="sr-only">
          {t(userLanguage, 'search:searchOptions')}
        </legend>
        <label>
          {t(userLanguage, 'search:matchPartial')}
          <input
            type="checkbox"
            name="matchpartial"
            value="true"
            checked={matchPartial}
          />
        </label>
        {pathname !== '/search-filter' && (
          <details id="filters-panel" name="search-panel">
            <summary>
              <Icon name="informationCircle" mini />
              <span class="sr-only">
                {t(userLanguage, 'interface:searchFilter')}
              </span>
            </summary>
            <SearchFilterContent />
          </details>
        )}
        {pathname === '/search-options' ? (
          <SearchOptionsContent />
        ) : (
          <details id="languages-panel" name="search-panel">
            <summary>
              <Icon name="globeAlt" mini />
              {!!languageArray?.length && (
                <span> ({languageArray.length})</span>
              )}
              <span class="sr-only">
                {t(userLanguage, 'interface:languages')}
              </span>
            </summary>
            <SearchOptionsContent />
          </details>
        )}
      </fieldset>
    )
  }
</form>

<style>
  form[role='search'] {
    --bar-width: min(var(--content-max-width), 100%);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    > fieldset:first-of-type {
      display: flex;
      flex: 1;
      box-sizing: border-box;
      max-width: var(--bar-width);
      margin: 0;
      padding: 0.4rem;
      border: 1px solid;
      border-radius: var(--rounding);
      border-color: var(--text-color-secondary);

      &:focus-within {
        border-color: var(--primary-color);
        outline: var(--focus-ring);
        outline-offset: -1px;

        /* Forced colours repaint the border, and Highlight can be see-through */
        @media (forced-colors: active) {
          border-color: Canvas;
        }
      }

      input {
        width: 100%;
        border: none;
        background-color: inherit;
        color: inherit;
        font-size: large;

        &:focus {
          outline: none;
        }
      }

      button {
        border: none;
        background: none;
        color: inherit;
        font-size: inherit;
        cursor: pointer;
      }

      @media (hover: hover) {
        > button[formmethod='dialog'] {
          display: none;
        }
      }
    }

    > fieldset:nth-of-type(2) {
      --toggle-size: 1.75rem;
      --languages-toggle-size: var(--toggle-size);
      --toggles-end: calc(100% - var(--bar-width));
      --filters-toggle-end: calc(
        var(--toggles-end) + var(--languages-toggle-size) + 0.25rem
      );
      --label-end: calc(
        var(--filters-toggle-end) + var(--toggle-size) + 0.5rem
      );
      position: relative;
      margin: 0;
      border: none;
      padding: 0;
      color: var(--text-color-secondary);

      /* 1.1em for the gap and brackets, and 1ch per tabular digit */
      &.with-count {
        --languages-toggle-size: calc(
          var(--toggle-size) + 1.1em + var(--count-digits) * 1ch
        );
      }

      &.without-languages {
        --filters-toggle-end: var(--toggles-end);
      }

      &.without-filters {
        --label-end: calc(
          var(--toggles-end) + var(--languages-toggle-size) + 0.5rem
        );
      }

      > label {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        width: fit-content;
        min-height: var(--toggle-size);
        margin-inline: auto var(--label-end);
        text-align: end;
        cursor: pointer;
      }

      > details > summary {
        position: absolute;
        inset-block-start: 0;
        inset-inline-end: var(--toggles-end);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25em;
        box-sizing: border-box;
        min-width: var(--toggle-size);
        height: var(--toggle-size);
        margin: 0;
        padding: 0 0.25rem;
        border-radius: var(--rounding);
        list-style: none;
        font-variant-numeric: tabular-nums;
        cursor: pointer;

        /* Safari before 18.4 draws it even on a flex summary */
        &::-webkit-details-marker {
          display: none;
        }

        &:hover {
          background-color: var(--primary-color);
          color: var(--background-color);
        }
      }

      > details[open] > summary:not(:hover) {
        color: var(--primary-color);
      }

      > #filters-panel > summary {
        inset-inline-end: var(--filters-toggle-end);
      }

      > #languages-panel > summary {
        width: var(--languages-toggle-size);
      }

      :global(fieldset) {
        margin: 0.5rem 0 0;
        border: 1px solid var(--bg-alt-4);
        border-radius: var(--rounding);
        padding: 1rem;

        > :global(legend) {
          margin: 0;
          padding: 0 0.5rem;
          color: var(--text-color-secondary);
        }
      }

      :global(fieldset#search-filters) {
        color: var(--text-color);
      }
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#search-modal')
  const input = document.querySelector<HTMLInputElement>('#search-input')

  // As on .net, unless a text's Hot keys setting is off
  function hotkey(event: KeyboardEvent) {
    if (event.metaKey || event.ctrlKey || event.altKey) return false
    if (!['/', 's', 'S', ']'].includes(event.key)) return false
    const shortcutter = document.getElementById('shortcutter')
    if (shortcutter instanceof HTMLInputElement && !shortcutter.checked)
      return false
    const target = event.target
    return !(
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        target.matches(
          'input:not([type="checkbox"], [type="range"]), textarea, select'
        ))
    )
  }

  document.addEventListener('keydown', event => {
    const toggle = (event.metaKey || event.ctrlKey) && event.key === 'k'
    if (!toggle && !hotkey(event)) return
    event.preventDefault()

    if (dialog) {
      if (!dialog.open) dialog.showModal()
      else if (toggle) dialog.close()
      return
    }
    if (!input) return

    input.focus()
    // After the browser's own focus handling, which puts the caret at the start
    requestAnimationFrame(() => {
      const { value } = input
      // The caret only moves to the end when the value changes
      input.value = ''
      input.value = value
    })
  })

  if (dialog) {
    // Invoker commands and closedby are too new for some browsers
    const invokers = 'commandForElement' in HTMLButtonElement.prototype
    document
      .querySelectorAll<HTMLButtonElement>('button[commandfor="search-modal"]')
      .forEach(button => {
        if (button.dataset.shortcut) button.title = button.dataset.shortcut
        if (!invokers)
          button.addEventListener('click', () => dialog.showModal())
      })
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', event => {
        if (event.target === dialog) dialog.close()
      })
    }

    // Safari's search field keeps Escape from the dialog, even once empty
    dialog.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !input?.value) dialog.close()
    })
  }
</script>
