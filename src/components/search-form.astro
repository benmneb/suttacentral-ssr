---
import SearchFilterContent from '~/components/search-filter-content.astro'
import SearchOptionsContent from '~/components/search-options-content.astro'
import Icon from '~/components/icon.astro'
import { t } from '~/i18n'

interface Props {
  matchPartial?: boolean
  query?: string | null
  autoFocus?: boolean
  languageArray?: string[]
  inDialog?: boolean
}

const {
  matchPartial = false,
  query,
  autoFocus = true,
  languageArray,
  inDialog,
} = Astro.props
const pathname = Astro.url.pathname
const isSearchPage = pathname.startsWith('/search')

const userLanguage = Astro.locals.userLanguage
---

<form action="/search" method="get" role="search">
  <fieldset>
    <label for="search-input" class="sr-only"
      >{t(userLanguage, 'search:search')}</label
    >
    <input
      id="search-input"
      type="search"
      placeholder={`${t(userLanguage, 'search:search')}…`}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      name="query"
      required
      autofocus={autoFocus}
      value={query}
    />
    <button aria-label={t(userLanguage, 'search:search')} type="submit"
      ><Icon name="magnifyingGlass" mini /></button
    >
    {
      inDialog && (
        <button
          formmethod="dialog"
          formnovalidate
          aria-label={t(userLanguage, 'search:closeSearch')}
        >
          <Icon name="xMark" mini />
        </button>
      )
    }
  </fieldset>
  {
    isSearchPage && (
      <fieldset>
        <legend class="sr-only">
          {t(userLanguage, 'search:searchOptions')}
        </legend>
        <label>
          {t(userLanguage, 'search:matchPartial')}
          <input
            type="checkbox"
            name="matchpartial"
            value="true"
            checked={matchPartial}
          />
        </label>
        {/* Owned by no form, so not sent with the search */}
        <input
          type="radio"
          name="search-panel"
          id="panel-none"
          form="search-panels"
          class="sr-only"
          aria-label={t(userLanguage, 'bottomsheet:close')}
          checked
        />
        {pathname !== '/search-filter' && (
          <>
            <input
              type="radio"
              name="search-panel"
              id="filter-toggle"
              form="search-panels"
              class="sr-only"
            />
            <label for="filter-toggle" class="panel-toggle">
              <Icon name="informationCircle" mini />
              <span class="sr-only">
                {t(userLanguage, 'interface:searchFilter')}
              </span>
            </label>
            <label for="panel-none" class="panel-toggle panel-close">
              <Icon name="informationCircle" mini />
            </label>
          </>
        )}
        {pathname !== '/search-options' && (
          <>
            <input
              type="radio"
              name="search-panel"
              id="language-toggle"
              form="search-panels"
              class="sr-only"
            />
            <label for="language-toggle" class="panel-toggle">
              <Icon name="globeAlt" mini />
              {!!languageArray?.length && (
                <span> ({languageArray.length})</span>
              )}
              <span class="sr-only">
                {t(userLanguage, 'interface:languages')}
              </span>
            </label>
            <label for="panel-none" class="panel-toggle panel-close">
              <Icon name="globeAlt" mini />
              {!!languageArray?.length && (
                <span> ({languageArray.length})</span>
              )}
            </label>
          </>
        )}
        {pathname !== '/search-filter' && <SearchFilterContent />}
        <SearchOptionsContent />
      </fieldset>
    )
  }
</form>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    > fieldset:first-of-type {
      display: flex;
      flex: 1;
      margin: 0;
      padding: 0.4rem;
      border: 1px solid;
      border-radius: var(--rounding);
      border-color: var(--text-color-secondary);

      &:focus-within {
        border-color: inherit;
        /* The browser's own ring, the first line where -webkit-focus-ring-color is unknown */
        outline: 1px auto;
        outline: auto 1px -webkit-focus-ring-color;
      }

      input {
        width: 100%;
        border: none;
        background-color: inherit;
        color: inherit;
        font-size: large;

        &:focus {
          outline: none;
        }
      }

      button {
        border: none;
        background: none;
        color: inherit;
        font-size: inherit;
        cursor: pointer;
      }

      @media (hover: hover) {
        > button[formmethod='dialog'] {
          display: none;
        }
      }
    }

    > label {
      display: flex;
      align-items: center;
      align-self: end;
      gap: 0.25rem;
      white-space: nowrap;
      cursor: pointer;
    }

    > fieldset:nth-of-type(2) {
      border: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: end;
      gap: 0.5rem;
      color: var(--text-color-secondary);

      .panel-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25em;
        box-sizing: border-box;
        min-width: 1.75rem;
        height: 1.75rem;
        margin: -0.125rem -0.25rem;
        padding: 0 0.25rem;
        border-radius: var(--rounding);
        cursor: pointer;

        &:hover {
          background-color: var(--primary-color);
          color: var(--background-color);
        }
      }

      .panel-close {
        color: var(--primary-color);
      }

      #filter-toggle:checked + label,
      #filter-toggle:not(:checked) + label + .panel-close,
      #language-toggle:checked + label,
      #language-toggle:not(:checked) + label + .panel-close {
        display: none;
      }

      > :global(fieldset) {
        width: 100%;
        margin: 0;
        border: 1px solid var(--bg-alt-4);
        border-radius: var(--rounding);
        padding: 1rem;

        > :global(legend) {
          margin: 0;
          padding: 0 0.5rem;
          color: var(--text-color-secondary);
        }
      }

      /* Apart, as Astro mangles a selector list with :global in it */
      #filter-toggle:not(:checked) ~ :global(fieldset#search-filters) {
        display: none;
      }

      #language-toggle:not(:checked) ~ :global(fieldset#search-options) {
        display: none;
      }

      > :global(fieldset#search-filters) {
        color: var(--text-color);
      }
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#search-modal')
  const input = document.querySelector<HTMLInputElement>('#search-input')

  document.addEventListener('keydown', event => {
    if (!(event.metaKey || event.ctrlKey) || event.key !== 'k') return
    event.preventDefault()

    if (dialog) {
      if (dialog.open) dialog.close()
      else dialog.showModal()
      return
    }
    if (!input) return

    input.focus()
    // After the browser's own focus handling, which puts the caret at the start
    requestAnimationFrame(() => {
      const { value } = input
      // The caret only moves to the end when the value changes
      input.value = ''
      input.value = value
    })
  })

  if (dialog) {
    // Invoker commands and closedby are too new for some browsers
    if (!('commandForElement' in HTMLButtonElement.prototype)) {
      document
        .querySelectorAll('button[commandfor="search-modal"]')
        .forEach(button =>
          button.addEventListener('click', () => dialog.showModal())
        )
    }
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', event => {
        if (event.target === dialog) dialog.close()
      })
    }

    // Safari's search field keeps Escape from the dialog, even once empty
    dialog.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !input?.value) dialog.close()
    })
  }
</script>
