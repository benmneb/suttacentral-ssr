---
import SearchFilterContent from '~/components/search-filter-content.astro'
import SearchOptionsContent from '~/components/search-options-content.astro'
import * as heroicon from '~/constants/heroicons'
import { t } from '~/i18n'

interface Props {
  matchPartial?: boolean
  query?: string | null
  autoFocus?: boolean
  languageArray?: string[]
}

const {
  matchPartial = false,
  query,
  autoFocus = true,
  languageArray,
} = Astro.props
const pathname = Astro.url.pathname
const isSearchPage = pathname.startsWith('/search')

const userLanguage = Astro.locals.userLanguage
---

<form action="/search" method="get" role="search">
  <fieldset>
    <label for="search-input" class="sr-only"
      >{t(userLanguage, 'search:search')}</label
    >
    <input
      id="search-input"
      type="search"
      placeholder={`${t(userLanguage, 'search:search')}…`}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      name="query"
      required
      autofocus={autoFocus}
      value={query}
    />
    <button aria-label={t(userLanguage, 'search:search')} type="submit"
      ><Fragment set:html={heroicon.magnifyingGlass} /></button
    >
  </fieldset>
  {
    isSearchPage && (
      <fieldset>
        <legend class="sr-only">
          {t(userLanguage, 'search:searchOptions')}
        </legend>
        <label>
          {t(userLanguage, 'search:matchPartial')}
          <input
            type="checkbox"
            name="matchpartial"
            value="true"
            checked={matchPartial}
          />
        </label>
        {/* Owned by no form, so not sent with the search */}
        <input
          type="radio"
          name="search-panel"
          id="panel-none"
          form="search-panels"
          class="sr-only"
          aria-label={t(userLanguage, 'bottomsheet:close')}
          checked
        />
        {pathname !== '/search-filter' && (
          <>
            <input
              type="radio"
              name="search-panel"
              id="filter-toggle"
              form="search-panels"
              class="sr-only"
            />
            <label for="filter-toggle" class="panel-toggle">
              <Fragment set:html={heroicon.informationCircle} />
              <span class="sr-only">
                {t(userLanguage, 'interface:searchFilter')}
              </span>
            </label>
            <label for="panel-none" class="panel-toggle panel-close">
              <Fragment set:html={heroicon.informationCircle} />
            </label>
          </>
        )}
        {pathname !== '/search-options' && (
          <>
            <input
              type="radio"
              name="search-panel"
              id="language-toggle"
              form="search-panels"
              class="sr-only"
            />
            <label for="language-toggle" class="panel-toggle">
              <Fragment set:html={heroicon.globeAlt} />
              {!!languageArray?.length && (
                <span> ({languageArray.length})</span>
              )}
              <span class="sr-only">
                {t(userLanguage, 'interface:languages')}
              </span>
            </label>
            <label for="panel-none" class="panel-toggle panel-close">
              <Fragment set:html={heroicon.globeAlt} />
              {!!languageArray?.length && (
                <span> ({languageArray.length})</span>
              )}
            </label>
          </>
        )}
        {pathname !== '/search-filter' && <SearchFilterContent />}
        <SearchOptionsContent />
      </fieldset>
    )
  }
</form>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    > fieldset:first-of-type {
      display: flex;
      flex: 1;
      margin: 0;
      padding: 0.4rem;
      border: 1px solid;
      border-radius: var(--rounding);
      border-color: var(--bg-alt-4);

      &:focus-within {
        border-color: inherit;
      }

      input {
        width: 100%;
        border: none;
        background-color: inherit;
        color: inherit;
        font-size: large;

        &:focus {
          outline: none;
        }
      }

      button {
        border: none;
        background: none;
        font-size: inherit;
        cursor: pointer;
      }
    }

    > label {
      display: flex;
      align-items: center;
      align-self: end;
      gap: 0.25rem;
      white-space: nowrap;
      cursor: pointer;
    }

    > fieldset:nth-of-type(2) {
      border: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: end;
      gap: 0.5rem;
      color: var(--text-color-secondary);

      .panel-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25em;
        box-sizing: border-box;
        min-width: 1.75rem;
        height: 1.75rem;
        margin: -0.125rem -0.25rem;
        padding: 0 0.25rem;
        border-radius: var(--rounding);
        cursor: pointer;

        &:hover {
          background-color: var(--primary-color);
          color: var(--background-color);
        }
      }

      .panel-close {
        color: var(--primary-color);
      }

      #filter-toggle:checked + label,
      #filter-toggle:not(:checked) + label + .panel-close,
      #language-toggle:checked + label,
      #language-toggle:not(:checked) + label + .panel-close {
        display: none;
      }

      > :global(fieldset) {
        width: 100%;
        margin: 0;
        border: 1px solid var(--bg-alt-4);
        border-radius: var(--rounding);
        padding: 1rem;

        > :global(legend) {
          margin: 0;
          padding: 0 0.5rem;
          color: var(--text-color-secondary);
        }
      }

      /* Apart, as Astro mangles a selector list with :global in it */
      #filter-toggle:not(:checked) ~ :global(fieldset#search-filters) {
        display: none;
      }

      #language-toggle:not(:checked) ~ :global(fieldset#search-options) {
        display: none;
      }

      > :global(fieldset#search-filters) {
        color: var(--text-color);
      }
    }
  }
</style>

<script>
  'use strict'

  const popover = document.getElementById('search-modal')
  const input = document.querySelector<HTMLInputElement>('#search-input')

  document.addEventListener('keydown', function (event) {
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault()

      if (popover) {
        popover.togglePopover()
      }

      if (window.location.pathname.startsWith('/search') && input) {
        input.focus()

        // Run after the browser's own focus handling, to put cursor at the end, not the start
        requestAnimationFrame(() => {
          const { value } = input
          // It only moves the caret to the end when the value actually changes...
          input.value = ''
          input.value = value
        })
      }
    }
  })

  // For the Windows 7 + Chrome 109 clan
  if (!('popover' in HTMLElement.prototype)) {
    const searchButton = document.querySelector(
      'button[popovertarget="search-modal"]'
    )
    if (searchButton) {
      searchButton.addEventListener('click', event => {
        event.preventDefault()
        window.location.href = '/search'
      })
    }
  }
</script>
