---
import '~/assets/text-meta-content.css'
import { icon } from '~/constants/heroicons'
import { t } from '~/i18n'

interface Props {
  acronym?: string
  altAcronym?: string | null
  language?: string
  volpages?: string[] // formatted already
  userLanguage: string
}

const {
  acronym,
  altAcronym,
  language,
  volpages = [],
  userLanguage,
} = Astro.props
const pageTitle = t(userLanguage, 'suttaplex:volumeAndPage')
const altTitle = t(
  userLanguage,
  altAcronym?.startsWith('T ')
    ? 'suttaplex:taishoNumber'
    : 'suttaplex:alternateNumber'
)

const parts: { text: string; title?: string; className?: string }[] = [
  { text: acronym?.trim() ?? '' },
  { text: altAcronym?.trim() ?? '', title: altTitle, className: 'alt-acronym' },
  { text: language ?? '' },
  ...volpages.map(text => ({ text, title: pageTitle, className: 'volpages' })),
].filter(part => part.text)

// No space before a ∙, so a line only wraps after one
const html = parts
  .map(({ text, title, className }, i) => {
    const dot = i ? '<span aria-hidden="true">∙</span> ' : ''
    const pageIcon = className === 'volpages' ? icon('bookOpen') : ''
    const value = title
      ? `<span title="${title}"><span class="sr-only">${title}: </span>${pageIcon}${text}</span>`
      : text
    return `<span${className ? ` class="${className}"` : ''}>${dot}${value}</span>`
  })
  .join('')
---

<Fragment set:html={html} />
