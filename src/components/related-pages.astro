---
import * as heroicon from '~/constants/heroicons'
import { staticPages, type StaticPageCategory } from '~/constants/static-pages'
import { t } from '~/i18n'

interface Props {
  category: StaticPageCategory
  currentHref?: string
}

const { category, currentHref } = Astro.props

const userLanguage = Astro.locals.userLanguage

const currentPath = currentHref ?? Astro.url.pathname.replace(/\/$/, '')
---

<aside>
  <nav>
    <ol>
      {
        staticPages[category].map(({ href, label }) => (
          <li>
            {currentPath === href ? (
              <span aria-current="page">{t(userLanguage, label)}</span>
            ) : href.startsWith('https://') ? (
              <a href={href}>
                {t(userLanguage, label)}
                <Fragment set:html={heroicon.arrowTopRightOnSquareMicro} />
                <span class="sr-only">SuttaCentral.net</span>
              </a>
            ) : (
              <a href={href}>{t(userLanguage, label)}</a>
            )}
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<style>
  /* Keep these styles inline so they're scoped */
  aside {
    display: flex;
    justify-content: start;
    pointer-events: none;
    margin-bottom: 2rem;

    nav {
      padding: 0;
      border: none;
      margin: 0;
      background-color: var(--bg-alt-1);
      border-top-right-radius: var(--rounding);
      border-bottom-right-radius: var(--rounding);
      pointer-events: auto;

      ol {
        list-style: none;
        margin: 0;
        padding: 0 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 0;

        li {
          display: flex;
          position: relative;
          color: var(--fg-alt-3);

          &:not(li:last-of-type) {
            margin-right: 0.5rem;

            &::after {
              content: '∙';
              content: '∙' / '';
              margin-left: 0.5rem;
            }
          }

          a {
            text-decoration: none;
            display: flex;

            align-items: center;

            > :global(.icon) {
              margin-inline-start: 0.25em;
            }
          }
        }
      }
    }
  }
</style>
