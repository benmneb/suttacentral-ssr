---
import * as heroicon from '~/constants/heroicons'
import { siteMap } from '~/constants/static-pages'
import { t } from '~/i18n'
import { getPreferredLanguage } from '~/utils/language'

const acceptLanguage = Astro.request.headers.get('accept-language')
const userLanguage = getPreferredLanguage(acceptLanguage)

const currentPath = Astro.url.pathname.replace(/\/$/, '')
---

<nav
  id="site-pages"
  popover
  aria-label={t(userLanguage, 'interface:sitePages')}
>
  {
    siteMap.map(({ label, pages }) => (
      <section>
        <h2>{t(userLanguage, label)}</h2>
        <ul>
          {pages.map(({ href, label }) =>
            currentPath === href ? (
              <li>
                <span aria-current="page">{t(userLanguage, label)}</span>
              </li>
            ) : href.startsWith('https://') ? (
              <li>
                <a href={href}>
                  {t(userLanguage, label)}
                  <Fragment set:html={heroicon.arrowTopRightOnSquareMicro} />
                  <span class="sr-only">SuttaCentral.net</span>
                </a>
              </li>
            ) : (
              <li>
                <a href={href}>{t(userLanguage, label)}</a>
              </li>
            )
          )}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  /* Keep these styles inline so they're scoped */
  /* Dropped from the menu button at the top right, wide enough for three
     columns of groups. Border box, so its padding stays inside the gutters
     on a phone. Its height fits its content and its rows start at the top:
     Safari otherwise grows the popover, then stretches the rows to fill it,
     leaving space under each group */
  nav {
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    align-content: start;
    gap: 1rem;
    height: fit-content;
    box-sizing: border-box;
    inset: 2.75rem 1rem auto auto;
    margin: 0;
    max-width: min(30rem, 100vw - 2rem);

    section {
      height: fit-content;
    }
  }

  /* Apart, as browsers without :popover-open drop the whole rule */
  nav:popover-open {
    display: grid;
  }

  @supports (anchor-name: --a) {
    nav {
      position-anchor: --site-pages-button;
      top: calc(anchor(bottom) + 0.5rem);
    }
  }

  @supports not selector(:popover-open) {
    nav {
      display: grid;
      width: var(--width-minus-padding);
      max-width: var(--content-max-width);
      max-height: none;
      margin: 2rem auto 0;
      box-shadow: none;
      overflow: visible;
    }
  }

  h2 {
    font-size: inherit;
    margin: 0 0 0.25rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.125rem 0;
  }

  /* Flex drops the markup's spaces, so the underline stops at the words */
  a {
    display: inline-flex;
    align-items: center;
  }

  a > :global(.icon) {
    margin-inline-start: 0.25em;
  }

  [aria-current='page'] {
    color: var(--text-color-secondary);
  }
</style>
