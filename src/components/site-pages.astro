---
import { pageIcons, siteMap } from '~/constants/static-pages'
import { t } from '~/i18n'

const userLanguage = Astro.locals.userLanguage

const currentPath = Astro.url.pathname.replace(/\/$/, '')
---

<nav
  id="site-pages"
  popover
  aria-label={t(userLanguage, 'interface:sitePages')}
>
  {
    siteMap.map(({ label, pages }) => (
      <section>
        <h2>{t(userLanguage, label)}</h2>
        <ul>
          {pages.map(({ href, label }) => (
            <li>
              <Fragment set:html={pageIcons[href]} />
              {currentPath === href ? (
                <span aria-current="page">{t(userLanguage, label)}</span>
              ) : (
                <a
                  href={href}
                  rel={href.startsWith('http') ? 'external' : undefined}
                >
                  {t(userLanguage, label)}
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  /* Keep these styles inline so they're scoped */
  /* fit-content, else Safari stretches the rows to fill the popover */
  nav {
    grid-template-columns: repeat(auto-fit, minmax(9.75rem, 1fr));
    grid-template-columns: repeat(auto-fit, minmax(min(9.75rem, 100%), 1fr));
    align-content: start;
    gap: 1rem;
    height: fit-content;
    box-sizing: border-box;
    inset: 2.75rem 1rem auto auto;
    margin: 0;
    max-width: min(34rem, 100vw - 2rem);
    /* 5.5rem clears the menu button, even when it wraps below search */
    max-height: calc(100dvh - 5.5rem);
    overflow-y: auto;

    section {
      height: fit-content;
    }
  }

  /* Apart, as browsers without :popover-open drop the whole rule */
  nav:popover-open {
    display: grid;
  }

  @supports (anchor-name: --a) {
    nav {
      position-anchor: --site-pages-button;
      top: calc(anchor(bottom) + 0.5rem);
    }
  }

  @supports not selector(:popover-open) {
    nav {
      display: grid;
      width: var(--width-minus-padding);
      max-width: var(--content-max-width);
      max-height: none;
      margin: 2rem auto 0;
      box-shadow: none;
      overflow: visible;
    }
  }

  h2 {
    font-size: inherit;
    margin: 0 0 0.25rem;
  }

  ul {
    margin: 0;
    padding: 0;
  }

  /* On the items, as text.css gives list items in a section bullets back */
  li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    padding: 0.125rem 0;
    overflow-wrap: anywhere;

    > :global(.icon) {
      color: var(--text-color-secondary);
    }
  }

  [aria-current='page'] {
    color: var(--text-color-secondary);
  }
</style>
