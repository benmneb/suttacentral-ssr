---
import RootTitle from '~/components/root-title.astro'
import TextRefs from '~/components/text-refs.astro'
import { langTag } from '~/utils/language'
import {
  getHashFragment,
  parallelTypeName,
  parallelTypeTitle,
} from '~/utils/parallels'
import { formatVolpages } from '~/utils/strings'

interface Props {
  parallels: any[] // one key's entries from /api/parallels
  userLanguage: string
  // Off where the list is already headed with its type
  typeTitles?: boolean
}

const { parallels, userLanguage, typeTitles = true } = Astro.props
---

<ul class="parallel-list">
  {
    parallels.map(parallel => {
      const { to } = parallel
      const type = to.type
      const trans = to.translations?.[0]
      const href =
        trans &&
        `/${to.uid}/${trans.lang}/${trans.author_uid}${getHashFragment(to.to)}`
      const label = to.acronym?.trim()
      const titled = !!(
        to.original_title?.trim() || to.translated_title?.trim()
      )
      const volpages = formatVolpages(to.volpages)
      const typeName = typeTitles ? parallelTypeName(userLanguage, type) : ''

      return (
        <li
          class={`parallel-list-item-${type}`}
          title={typeTitles ? parallelTypeTitle(userLanguage, type) : undefined}
        >
          {typeName && <span class="sr-only">{`${typeName}: `}</span>}
          {titled ? (
            <RootTitle
              root={to.original_title}
              translation={to.translated_title}
              lang={to.root_lang}
              href={href}
            />
          ) : href ? (
            <a href={href} hreflang={langTag(trans.lang)}>
              {label}
            </a>
          ) : (
            <span>{label}</span>
          )}
          {((titled && label) || volpages) && (
            <p class="text-refs">
              <TextRefs
                acronym={titled ? label : undefined}
                volpages={[volpages]}
                userLanguage={userLanguage}
              />
            </p>
          )}
        </li>
      )
    })
  }
</ul>
