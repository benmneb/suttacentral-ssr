---
import { t } from '~/i18n'
import { languageName } from '~/utils/strings'

const { entry } = Astro.props
const data = entry[0]
const edition = data.edition?.[0] ?? {}
const license = data.license ?? {}

const userLanguage = Astro.locals.userLanguage

type Row = {
  label: string
  value: any
  property?: string
  type?: 'link' | 'date'
}

// The API gives false for a translation language a root text has none of
const filled = (value: unknown) =>
  value != null && value !== false && String(value).trim() !== ''

const external = (href: string) =>
  /^https?:/.test(href) ? 'external' : undefined

const sections = (
  [
    [
      'publication:basicTranslationDetails',
      [
        {
          label: 'publication:translationTitle',
          value: data.translation_title,
          property: 'dc:title',
        },
        {
          label: 'publication:translationSubTitle',
          value: data.translation_subtitle,
          property: 'dc:title',
        },
        {
          label: 'publication:translator',
          value: data.author_name,
          property: 'dc:creator',
        },
        {
          label: 'publication:collaborator',
          value: data.collaborator,
          property: 'dc:creator',
        },
      ],
    ],
    [
      'publication:languageInformation',
      [
        {
          label: 'publication:rootTitle',
          value: data.root_title,
          property: 'dc:title',
        },
        {
          label: 'publication:translationLanguage',
          value: languageName(data.translation_lang_name),
          property: 'dc:language',
        },
        {
          label: 'publication:rootLanguage',
          value: languageName(data.root_lang_name),
        },
      ],
    ],
    [
      'publication:descriptionAndProcess',
      [
        {
          label: 'publication:translationDescription',
          value: data.translation_description,
          property: 'dc:description',
        },
        {
          label: 'publication:translationProcess',
          value: data.translation_process,
          property: 'dc:description',
        },
        {
          label: 'publication:publicationStatus',
          value: data.publication_status,
        },
      ],
    ],
    [
      'publication:publicationDetails',
      [
        { label: 'publication:edition', value: edition.edition_number },
        {
          label: 'publication:publicationDate',
          value: edition.publication_date,
          property: 'dc:date',
          type: 'date',
        },
        {
          label: 'publication:publisher',
          value: edition.publisher,
          property: 'dc:publisher',
        },
        {
          label: 'publication:publicationType',
          value: edition.publication_type,
          property: 'dc:format',
        },
      ],
    ],
    [
      'publication:linksAndIdentifiers',
      [
        { label: 'publication:url', value: edition.edition_url, type: 'link' },
        { label: 'publication:source', value: data.source_url, type: 'link' },
        {
          label: 'publication:suttaCentralPublicationNumber',
          value: data._key,
          property: 'dc:identifier',
        },
      ],
    ],
  ] as [string, Row[]][]
)
  .map(([heading, rows]) => [heading, rows.filter(row => filled(row.value))])
  .filter(([, rows]) => rows.length) as [string, Row[]][]
---

<article id="info" popover>
  <h1>{t(userLanguage, 'publication:title')}</h1>

  <div about={data.source_url || undefined}>
    {
      sections.map(([heading, rows]) => (
        <section>
          <h2 class="sr-only">{t(userLanguage, heading)}</h2>
          <dl>
            {rows.map(({ label, value, property, type }) => (
              <>
                <dt>{t(userLanguage, label)}</dt>
                <dd property={property}>
                  {type === 'link' ? (
                    <a href={value} rel={external(value)}>
                      {value}
                    </a>
                  ) : type === 'date' ? (
                    <time datetime={value}>{value}</time>
                  ) : (
                    value
                  )}
                </dd>
              </>
            ))}
          </dl>
        </section>
      ))
    }
  </div>

  {
    [license.license_type, license.license_url, license.license_statement].some(
      filled
    ) && (
      <section>
        <h2>{t(userLanguage, 'publication:license')}</h2>
        {filled(license.license_type) && (
          <p property="dc:rights">{license.license_type}</p>
        )}
        {filled(license.license_url) && (
          <p>
            <a href={license.license_url} rel={external(license.license_url)}>
              {license.license_url}
            </a>
          </p>
        )}
        {filled(license.license_statement) && (
          <p>{license.license_statement}</p>
        )}
      </section>
    )
  }
</article>
