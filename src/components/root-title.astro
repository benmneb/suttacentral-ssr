---
import { langTag } from '~/utils/language'
import { normalise, softHyphenateTitle } from '~/utils/strings'

interface Props {
  root?: string
  translation?: string
  lang?: string | null
  href?: string
}

const { href } = Astro.props
const lang = Astro.props.lang ? langTag(Astro.props.lang) : undefined
// The API leaves trailing spaces on names
const root = Astro.props.root?.trim()
const translation = Astro.props.translation?.trim()
const isPair =
  !!root && !!translation && normalise(root) !== normalise(translation)
// Some, eg lzh-sarv-bi-pm-pc170, have the English as their root name too
const isRoot = !!root && (isPair || !translation)
const name = softHyphenateTitle((isRoot ? root : translation) || '')
// By script, as romanised titles like Madhyamāgama are tagged lzh too
const upright =
  /[\p{Script=Han}\p{Script=Hangul}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Tibetan}]/u.test(
    name
  )
    ? 'upright'
    : undefined
---

{
  isPair ? (
    <span class="root-title">
      {href ? (
        <a href={href}>
          <i lang={lang} class={upright}>
            {name}
          </i>
        </a>
      ) : (
        <i lang={lang} class={upright}>
          {name}
        </i>
      )}
      {/* The space keeps the two apart in reader mode and copied text */}
      <span>{` ${translation}`}</span>
    </span>
  ) : isRoot ? (
    href ? (
      <a href={href}>
        <i lang={lang} class={upright}>
          {name}
        </i>
      </a>
    ) : (
      <i lang={lang} class={upright}>
        {name}
      </i>
    )
  ) : href ? (
    <a href={href}>{name}</a>
  ) : (
    name
  )
}
