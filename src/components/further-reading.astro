---
import * as heroicon from '~/constants/heroicons'
import { pageIcons, pitakaGuides } from '~/constants/static-pages'
import { t } from '~/i18n'
import type { EditionLink } from '~/utils/editions'

interface Props {
  uid: string | undefined
  edition?: EditionLink
  userLanguage: string
}

const { uid, edition, userLanguage } = Astro.props

const guides = (uid && pitakaGuides[uid]) || []
---

{
  (!!guides.length || !!edition) && (
    <ul
      class="further-reading"
      aria-label={t(userLanguage, 'interface:furtherReading')}
    >
      {guides.map(({ href, label }) => (
        <li>
          <a href={href}>
            <Fragment set:html={pageIcons[href] ?? heroicon.academicCapMicro} />
            <cite>{t(userLanguage, `${label}:1`)}</cite>
          </a>
          <span>{t(userLanguage, `${label}:2`)}</span>
        </li>
      ))}
      {edition && (
        <li>
          <a href={edition.href}>
            <Fragment set:html={heroicon.bookOpen} />
            <cite>{edition.title}</cite>
          </a>
          <span>{edition.creator}</span>
          <span class="tagline">
            {t(userLanguage, 'interface:suttaCentralEdition')}
          </span>
        </li>
      )}
    </ul>
  )
}

<style>
  .further-reading {
    list-style: none;
    margin-block: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--background-color-secondary);
    border-radius: var(--rounding);
  }

  li {
    padding-inline-start: calc(1em + 0.375rem);
  }

  li + li {
    margin-top: 0.75rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    margin-inline-start: calc(-1em - 0.375rem);
  }

  a > :global(.icon) {
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: calc((1lh - 1em) / 2);
    margin-inline-end: 0.375rem;
  }

  span {
    display: block;
    color: var(--text-color-secondary);
  }

  .tagline {
    font-size: smaller;
  }
</style>
