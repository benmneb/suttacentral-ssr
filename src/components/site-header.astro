---
import Icon from '~/components/icon.astro'
import { t } from '~/i18n'

const { breadcrumbs } = Astro.props
const pathname = Astro.url.pathname

const userLanguage = Astro.locals.userLanguage

function localiseTitle(title: string): string {
  if (!title) return ''
  for (const key of [title.toLowerCase(), title]) {
    const localized = t(userLanguage, `interface:${key}`)
    if (localized !== `interface:${key}`) return localized
  }
  return title
}

const localisedCrumbs = breadcrumbs?.map(c => ({
  ...c,
  title: localiseTitle(c.title),
}))
---

<header>
  <nav aria-label={t(userLanguage, 'header:breadcrumb')}>
    <ul>
      <li aria-current={pathname === '/' ? 'page' : undefined}>
        {
          pathname === '/' ? (
            <span>
              <Icon name="home" />
              <span class="sr-only">{t(userLanguage, 'interface:home')}</span>
            </span>
          ) : (
            <a href="/" aria-label={t(userLanguage, 'interface:home')}>
              <Icon name="home" />
              <span class="sr-only">{t(userLanguage, 'interface:home')}</span>
            </a>
          )
        }
      </li>{
        localisedCrumbs?.map((b, i, a) => (
          <li aria-current={i === a.length - 1 ? 'page' : undefined}>
            {b.url && i < a.length - 1 ? (
              <a href={b.url}>{b.title}</a>
            ) : (
              <span>{b.title}</span>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
  <div>
    {
      !pathname.startsWith('/search') && (
        <button
          class="icon-button"
          type="button"
          commandfor="search-modal"
          command="show-modal"
          aria-label={t(userLanguage, 'search:search')}
          title={t(userLanguage, 'header:searchShortcut')}
        >
          <Icon name="magnifyingGlass" />
        </button>
      )
    }
    <button
      class="icon-button"
      type="button"
      popovertarget="site-pages"
      aria-label={t(userLanguage, 'interface:sitePages')}
      title={t(userLanguage, 'interface:sitePages')}
    >
      <Icon name="bars3" />
    </button>
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin: 1rem;
    view-timeline-name: --site-header;

    /* rem, as the button's em is the browser's control font-size */
    & :global(.icon:not(.mini)) {
      inline-size: 1rem;
      block-size: 1rem;
    }

    ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0;
      margin: 0;
      scrollbar-width: none;
      &::-webkit-scrollbar {
        display: none;
      }

      li {
        list-style-type: none;
        display: flex;
        word-break: break-word;
        text-wrap: wrap;
        white-space: wrap;

        &:first-of-type > * {
          text-decoration: none;
          display: flex;
          align-items: center;
          justify-content: center;
          height: 1.75rem;
          margin: -0.125rem -0.375rem;
          padding: 0 0.375rem;
          border-radius: var(--rounding);
        }

        &::after {
          content: '/';
          content: '/' / '';
          margin-left: 0.5rem;
          color: var(--gray);
        }

        &:last-child::after {
          content: '';
        }
      }
    }

    & > div {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      flex-shrink: 1000;
      gap: 0.5rem;
    }

    button[popovertarget='site-pages'] {
      anchor-name: --site-pages-button;
    }

    > div > .icon-button {
      margin-block: -0.3125rem;
    }
  }
</style>
