---
import '~/assets/details.css'
import ParallelSegments from '~/components/parallel-segments.astro'
import Icon from '~/components/icon.astro'
import { SC_API } from '~/constants/urls'
import { t } from '~/i18n'
import { parallelSegments } from '~/utils/parallels'
import { toSentenceCase, uidToAcronym } from '~/utils/strings'
const {
  data: entry,
  parallelsOpen,
  userLanguage,
  isIndividualRangeSutta,
  inRangeSuttaId,
  parallelsData: preFetched,
  lazy,
  id,
} = Astro.props

// Lazy on list pages, where a fetch per card passes the Worker's 50 subrequests
const parallelsData = lazy
  ? null
  : (preFetched ??
    (await (await fetch(`${SC_API}/parallels/${entry.uid}`)).json()))

const rootTrans = entry.translations.find((t: any) => t.is_root)

// Filtered to include only relevant parallels for this individual range entry
const segments = lazy
  ? []
  : parallelSegments(
      parallelsData,
      isIndividualRangeSutta ? inRangeSuttaId : undefined
    )

const parallelCount =
  isIndividualRangeSutta && !lazy
    ? segments.reduce((sum, [, parallels]) => sum + parallels.length, 0)
    : entry.parallel_count

const linkText = t(userLanguage, 'viewoption:parallelsOf', {
  ref: entry.acronym || uidToAcronym(entry.uid),
})
---

<details
  open={!lazy && parallelsOpen && parallelCount}
  data-parallels={lazy && parallelCount ? entry.uid : undefined}
>
  <summary>
    {
      toSentenceCase(
        `${t(userLanguage, parallelCount !== 1 ? 'suttaplex:countParallels' : 'suttaplex:countParallel', { count: null })} ${t(userLanguage, 'suttaplex:inAncientTexts')}`
      )
    }
    ({parallelCount})
  </summary>
  {
    lazy && parallelCount ? (
      <ul>
        <li>
          <a class="with-icon" href={`/${entry.uid}#parallels`}>
            <span>{linkText}</span>
            <Icon name="arrowRight" />
          </a>
        </li>
      </ul>
    ) : (
      <ParallelSegments
        id={id}
        segments={segments}
        entry={entry}
        onScreenUid={isIndividualRangeSutta ? inRangeSuttaId : entry.uid}
        rootTrans={rootTrans}
        userLanguage={userLanguage}
      />
    )
  }
</details>
