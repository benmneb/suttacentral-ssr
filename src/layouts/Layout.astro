---
import '~/assets/_legacy_support.css'
import '~/assets/global.css'
import SearchForm from '~/components/search-form.astro'
import SiteFooter from '~/components/site-footer.astro'
import SiteHeader from '~/components/site-header.astro'
import SitePages from '~/components/site-pages.astro'
import { siteMetaData } from '~/constants/meta-data'
import { UMAMI_ORIGIN } from '~/constants/urls'
import { t } from '~/i18n'
import { textFromHtml } from '~/utils/json-ld'
import { langTag } from '~/utils/language'

const pathname = Astro.url.pathname
const siteHost = new URL(siteMetaData.origin).host
const userLanguage = Astro.locals.userLanguage
interface Props {
  title?: string
  description?: string
  breadcrumbs?: any[]
  jsonLd?: string
  canonical?: string
  ogImage?: string
  ogType?: 'website' | 'article'
  ogData?: Record<string, string | string[]>
  noindex?: boolean
}

const {
  title,
  description,
  breadcrumbs,
  jsonLd,
  canonical,
  ogImage,
  ogType,
  ogData = {},
  noindex,
} = Astro.props

const pageTitle = title
  ? `${title} @ ${siteMetaData.title}`
  : siteMetaData.title
const shareTitle = title || siteMetaData.title
const pageDescription = textFromHtml(description) || siteMetaData.description
// Without the query, which only holds settings or a search
const canonicalUrl = canonical || siteMetaData.origin + Astro.url.pathname
const shareUrl =
  canonical || siteMetaData.origin + Astro.url.pathname + Astro.url.search
const isError = ['/404', '/500'].includes(Astro.routePattern)

/** The reader's language as Open Graph takes it, language_TERRITORY, eg en_US */
function ogLocale(tag: string) {
  try {
    const { language, region } = new Intl.Locale(tag).maximize()
    if (region) return `${language}_${region}`
  } catch {}
  return 'en_US'
}
const imageUrl = new URL(ogImage || '/og-image2.jpg', siteMetaData.origin).href
// Here, not in icons.css, as the alt text is in the reader's language
const externalLinkAlt = JSON.stringify(
  ` (${t(userLanguage, 'interface:externalLink')})`
)
---

<!doctype html>
<html lang={langTag(userLanguage)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="250x250"
      href="/favicon-250x250.png"
    />
    <link rel="apple-touch-icon" sizes="250x250" href="/favicon-250x250.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {!isError && <link rel="canonical" href={canonicalUrl} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#1a1a2e"
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:site_name" content={siteMetaData.title} />
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:locale" content={ogLocale(langTag(userLanguage))} />
    <meta property="og:image" content={imageUrl} />
    {
      !ogImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:alt" content={siteMetaData.title} />
        </>
      )
    }
    {
      Object.entries(ogData)
        .filter(([k, v]) => v)
        .flatMap(([property, content]) =>
          Array.isArray(content) ? (
            content
              .filter(Boolean)
              .map(item => <meta property={property} content={item} />)
          ) : (
            <meta property={property} content={content} />
          )
        )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <style
      is:inline
      set:html={`:is(main, aside, #site-pages) a[href^='http']::after { content: '' / ${externalLinkAlt}; }`}
    ></style>
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script
      is:inline
      defer
      src={`${UMAMI_ORIGIN}/script.js`}
      data-website-id="1e65129e-1d78-4a78-a6d2-a339152f9a1d"
      data-domains={`${siteHost},www.${siteHost}`}
      data-exclude-search="true"
      data-exclude-hash="true"></script>
  </head>
  <body>
    <a class="skip" href="#main">{t(userLanguage, 'interface:skipToMain')}</a>
    <SiteHeader breadcrumbs={breadcrumbs} />
    <slot />
    <SitePages />
    <SiteFooter />
    {
      !pathname.startsWith('/search') && (
        <dialog
          id="search-modal"
          aria-label={t(userLanguage, 'search:search')}
          closedby="any"
        >
          <SearchForm inDialog />
        </dialog>
      )
    }
    <script>
      // Not the link's own jump, as Firefox then tabs on from a caret, on a text in a hidden segment number
      const skip = document.querySelector<HTMLAnchorElement>('body > .skip')
      skip?.addEventListener('click', event => {
        const target = document.getElementById(skip.hash.slice(1))
        if (!target) return
        event.preventDefault()
        target.tabIndex = -1
        target.focus({ preventScroll: true })
        target.scrollIntoView()
        const untab = () => target.removeAttribute('tabindex')
        target.addEventListener('blur', untab, { once: true })
      })
    </script>
  </body>
</html>
